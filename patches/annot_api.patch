+// Experimental API.
+// Set the /Vertices number array on a polygon or polyline annotation.
+// |points| is an array of FS_POINTF, |count| is the number of points
+// (not pairs). The /Vertices key in the annotation's dict is replaced
+// with an array of 2*count numbers in PDF user space (y-up).
+//
+//   annot  - handle to an annotation, as returned by e.g. FPDFPage_GetAnnot()
+//   points - array of FS_POINTF points
+//   count  - number of points in the |points| array
+//
+// Returns true on success, false if |annot| is not of type polygon or
+// polyline.
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_SetVertices(FPDF_ANNOTATION annot,
+                      const FS_POINTF* points,
+                      size_t count);
+
+// Experimental API.
+// Set the starting and ending coordinates of a line annotation.
+// Writes [start.x start.y end.x end.y] as a 4-number /L array.
+//
+//   annot  - handle to an annotation, as returned by e.g. FPDFPage_GetAnnot()
+//   start  - starting point
+//   end    - ending point
+//
+// Returns true on success, false if |annot| is not of type line or
+// |start| or |end| are NULL.
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_SetLine(FPDF_ANNOTATION annot,
+                  const FS_POINTF* start,
+                  const FS_POINTF* end);
+
+// Experimental API.
+// Set the line ending styles (/LE name pair) of a line annotation.
+// |start_name| and |end_name| are bytestrings naming the line ending
+// style (e.g., "OpenArrow", "Circle", "None"). See PDF spec Table 175.
+//
+//   annot      - handle to an annotation
+//   start_name - name of the start line ending style
+//   end_name   - name of the end line ending style
+//
+// Returns true on success, false if |annot| is not of type line or
+// |start_name| or |end_name| are NULL.
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_SetLineEndings(FPDF_ANNOTATION annot,
+                         FPDF_BYTESTRING start_name,
+                         FPDF_BYTESTRING end_name);
