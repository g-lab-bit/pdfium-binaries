+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_SetVertices(FPDF_ANNOTATION annot,
+                      const FS_POINTF* points,
+                      size_t count) {
+  FPDF_ANNOTATION_SUBTYPE subtype = FPDFAnnot_GetSubtype(annot);
+  if (subtype != FPDF_ANNOT_POLYGON && subtype != FPDF_ANNOT_POLYLINE) {
+    return false;
+  }
+  if (!points && count > 0) {
+    return false;
+  }
+  RetainPtr<CPDF_Dictionary> annot_dict =
+      GetMutableAnnotDictFromFPDFAnnotation(annot);
+  if (!annot_dict) {
+    return false;
+  }
+  auto vertices =
+      annot_dict->SetNewFor<CPDF_Array>(pdfium::annotation::kVertices);
+  // SAFETY: required from caller.
+  auto points_span = UNSAFE_BUFFERS(pdfium::span(points, count));
+  for (const auto& pt : points_span) {
+    vertices->AppendNew<CPDF_Number>(pt.x);
+    vertices->AppendNew<CPDF_Number>(pt.y);
+  }
+  return true;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_SetLine(FPDF_ANNOTATION annot,
+                  const FS_POINTF* start,
+                  const FS_POINTF* end) {
+  if (!start || !end) {
+    return false;
+  }
+  FPDF_ANNOTATION_SUBTYPE subtype = FPDFAnnot_GetSubtype(annot);
+  if (subtype != FPDF_ANNOT_LINE) {
+    return false;
+  }
+  RetainPtr<CPDF_Dictionary> annot_dict =
+      GetMutableAnnotDictFromFPDFAnnotation(annot);
+  if (!annot_dict) {
+    return false;
+  }
+  auto line = annot_dict->SetNewFor<CPDF_Array>(pdfium::annotation::kL);
+  line->AppendNew<CPDF_Number>(start->x);
+  line->AppendNew<CPDF_Number>(start->y);
+  line->AppendNew<CPDF_Number>(end->x);
+  line->AppendNew<CPDF_Number>(end->y);
+  return true;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_SetLineEndings(FPDF_ANNOTATION annot,
+                         FPDF_BYTESTRING start_name,
+                         FPDF_BYTESTRING end_name) {
+  if (!start_name || !end_name) {
+    return false;
+  }
+  FPDF_ANNOTATION_SUBTYPE subtype = FPDFAnnot_GetSubtype(annot);
+  if (subtype != FPDF_ANNOT_LINE) {
+    return false;
+  }
+  RetainPtr<CPDF_Dictionary> annot_dict =
+      GetMutableAnnotDictFromFPDFAnnotation(annot);
+  if (!annot_dict) {
+    return false;
+  }
+  auto le = annot_dict->SetNewFor<CPDF_Array>("LE");
+  le->AppendNew<CPDF_Name>(start_name);
+  le->AppendNew<CPDF_Name>(end_name);
+  return true;
+}
+
