diff --git a/fpdfsdk/fpdf_annot.cpp b/fpdfsdk/fpdf_annot.cpp
index d8d27d3..685e4a4 100644
--- a/fpdfsdk/fpdf_annot.cpp
+++ b/fpdfsdk/fpdf_annot.cpp
@@ -2480,6 +2480,38 @@ FPDF_EXPORT void FPDF_CALLCONV FPDFAnnot_ReleaseState(FPDF_DOCUMENT document,
 namespace {
 
 constexpr char kWrapOriginalKey[] = "RpOriginal";
+// A tinted wrapper records its tint and the annotation's /C from before the
+// first tint (an array, or /None when there was none), so removing the tint
+// puts /C back exactly.
+constexpr char kWrapTintKey[] = "RpTint";
+constexpr char kWrapOriginalColorKey[] = "RpOriginalC";
+
+// The tint of a wrapper form (|form| is a Rapida wrapper with /RpTint).
+std::optional<std::array<float, 3>> ReadWrapTint(const CPDF_Dictionary* form) {
+  RetainPtr<const CPDF_Array> tint =
+      form ? form->GetArrayFor(kWrapTintKey) : nullptr;
+  if (!tint || tint->size() != 3 || !form->KeyExist(kWrapOriginalKey)) {
+    return std::nullopt;
+  }
+  std::array<float, 3> rgb = {};
+  for (size_t i = 0; i < rgb.size(); ++i) {
+    RetainPtr<const CPDF_Number> n = tint->GetNumberAt(i);
+    if (!n) {
+      return std::nullopt;
+    }
+    rgb[i] = n->GetNumber();
+  }
+  return rgb;
+}
+
+// A colour entry as written — a direct array, or a reference to one (kept as
+// the reference, so putting it back is no change); nullptr for anything else.
+RetainPtr<const CPDF_Object> ColorEntry(const CPDF_Dictionary* dict,
+                                        ByteStringView key) {
+  RetainPtr<const CPDF_Object> entry = dict->GetObjectFor(key);
+  RetainPtr<const CPDF_Object> direct = entry ? entry->GetDirect() : nullptr;
+  return direct && direct->IsArray() ? entry : nullptr;
+}
 
 RetainPtr<CPDF_Dictionary> NewTransparencyGroup(CPDF_Document* doc) {
   auto group = doc->New<CPDF_Dictionary>();
@@ -2547,6 +2579,14 @@ FPDFAnnot_WrapAppearance(FPDF_DOCUMENT document,
   }
   RetainPtr<CPDF_Stream> original =
       ToStream(doc->GetOrParseIndirectObject(original_objnum));
+  // /C before the first tint: recorded on a tinted wrapper, else the
+  // annotation's own (nullptr: it has none).
+  // (Cloning a reference keeps the reference.)
+  const bool was_tinted = original_objnum != n_ref->GetRefObjNum() &&
+                          ReadWrapTint(current->GetDict().Get()).has_value();
+  RetainPtr<const CPDF_Object> original_color =
+      was_tinted ? ColorEntry(current->GetDict().Get(), kWrapOriginalColorKey)
+                 : ColorEntry(annot_dict.Get(), "C");
 
   // Validate the layer indices before changing anything.
   std::vector<uint32_t> ocg_objnums;
@@ -2596,6 +2636,22 @@ FPDFAnnot_WrapAppearance(FPDF_DOCUMENT document,
     annot_dict->SetFor("AP", ap_dict);
   }
 
+  // /C follows the tint: the tint colour, or what it was before the first tint.
+  if (tint_rgb) {
+    // SAFETY: required from caller (3 floats).
+    auto rgb = UNSAFE_BUFFERS(pdfium::span(tint_rgb, 3u));
+    auto color = annot_dict->SetNewFor<CPDF_Array>("C");
+    for (float c : rgb) {
+      color->AppendNew<CPDF_Number>(c);
+    }
+  } else if (was_tinted) {
+    if (original_color) {
+      annot_dict->SetFor("C", original_color->Clone());
+    } else {
+      annot_dict->RemoveFor("C");
+    }
+  }
+
   if (!tint_rgb && ocg_objnums.empty()) {
     if (original_objnum != n_ref->GetRefObjNum()) {
       ap_dict->SetNewFor<CPDF_Reference>("N", doc, original_objnum);  // unwrap
@@ -2673,6 +2729,42 @@ FPDFAnnot_WrapAppearance(FPDF_DOCUMENT document,
   RetainPtr<CPDF_Stream> wrapper = NewForm(doc, bbox, resources, false, content);
   wrapper->GetMutableDict()->SetNewFor<CPDF_Reference>(kWrapOriginalKey, doc,
                                                        original_objnum);
+  if (tint_rgb) {
+    // SAFETY: required from caller (3 floats).
+    auto rgb = UNSAFE_BUFFERS(pdfium::span(tint_rgb, 3u));
+    RetainPtr<CPDF_Dictionary> wrapper_dict = wrapper->GetMutableDict();
+    auto tint_record = wrapper_dict->SetNewFor<CPDF_Array>(kWrapTintKey);
+    for (float c : rgb) {
+      tint_record->AppendNew<CPDF_Number>(c);
+    }
+    if (original_color) {
+      wrapper_dict->SetFor(kWrapOriginalColorKey, original_color->Clone());
+    } else {
+      wrapper_dict->SetNewFor<CPDF_Name>(kWrapOriginalColorKey, "None");
