   ap_dict->SetNewFor<CPDF_Reference>("N", doc, wrapper->GetObjNum());
   return true;
 }
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_GetAppearanceTint(FPDF_ANNOTATION annot, float* rgb) {
+  const CPDF_Dictionary* annot_dict = GetAnnotDictFromFPDFAnnotation(annot);
+  if (!annot_dict || !rgb) {
+    return false;
+  }
+  RetainPtr<const CPDF_Dictionary> ap = annot_dict->GetDictFor("AP");
+  RetainPtr<const CPDF_Stream> n =
+      ap ? ToStream(ap->GetDirectObjectFor("N")) : nullptr;
+  std::optional<std::array<float, 3>> tint =
+      n ? ReadWrapTint(n->GetDict().Get()) : std::nullopt;
+  if (!tint) {
+    return false;
+  }
+  // SAFETY: required from caller (3 floats).
+  auto out = UNSAFE_BUFFERS(pdfium::span(rgb, 3u));
+  for (size_t i = 0; i < out.size(); ++i) {
+    out[i] = (*tint)[i];
+  }
+  return true;
+}
