+}
+
+// g-lab-bit fork (ocg_objnums.patch).
+FPDF_EXPORT int FPDF_CALLCONV
+FPDFDoc_GetLastModifiedObjects(FPDF_DOCUMENT document,
+                               uint32_t* buffer,
+                               int count) {
+  auto* doc = CPDFDocumentFromFPDFDocument(document);
+  if (!doc || count < 0) {
+    return -1;
+  }
+  const std::vector<uint32_t>& objnums = doc->GetLastModifiedObjects();
+  if (buffer && count > 0) {
+    // SAFETY: required from caller.
+    auto out = UNSAFE_BUFFERS(pdfium::span(buffer, static_cast<size_t>(count)));
+    const size_t n = std::min(objnums.size(), out.size());
+    for (size_t i = 0; i < n; ++i) {
+      out[i] = objnums[i];
+    }
+  }
+  return pdfium::checked_cast<int>(objnums.size());
+}
