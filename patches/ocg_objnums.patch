+// g-lab-bit fork (ocg_objnums.patch).
+FPDF_EXPORT uint32_t FPDF_CALLCONV
+FPDFDoc_GetOCPropertiesObjectNumber(FPDF_DOCUMENT document) {
+  auto* doc = CPDFDocumentFromFPDFDocument(document);
+  const CPDF_Dictionary* root = doc ? doc->GetRoot() : nullptr;
+  const CPDF_Reference* ref =
+      root ? ToReference(root->GetObjectFor("OCProperties").Get()) : nullptr;
