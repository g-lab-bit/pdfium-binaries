 // |annot| must come from a page of |doc|, or /OC would reference an object of
 // another document.
+// g-lab-bit fork (ocg_objnums.patch): collects the indirect objects of the
+// optional content structures an OCG write call can modify - /OCProperties,
+// its /OCGs, /D and /Configs dictionaries and their arrays (/ON, /OFF,
+// /Locked, /Order, /RBGroups, /AS with its /OCGs and /Category), OCG
+// dictionaries, and OCMDs with their /OCGs and /VE. Only these structures are
+// entered and recorded: a reference to anything else (a page, the catalog, a
+// resource dictionary, a stream) is neither followed nor recorded, so the
+// walk stays bounded however the file links them.
+class OCStructureWalker {
+ public:
+  OCStructureWalker(CPDF_Document* doc, std::set<uint32_t>* out)
+      : doc_(doc), out_(out) {}
+
+  void Properties(RetainPtr<const CPDF_Object> obj) {
+    RetainPtr<const CPDF_Object> props = Take(std::move(obj), kUntypedDict);
+    const CPDF_Dictionary* dict = props ? props->AsDictionary() : nullptr;
+    if (!dict) {
+      return;
+    }
+    GroupArray(dict->GetObjectFor("OCGs"));
+    Config(dict->GetObjectFor("D"));
+    RetainPtr<const CPDF_Object> configs =
+        Take(dict->GetObjectFor("Configs"), kArray);
+    if (configs) {
+      ForEach(configs, [this](RetainPtr<const CPDF_Object> e) { Config(e); });
+    }
+  }
+
+  // An annotation's /OC: an OCG or an OCMD.
+  void Membership(RetainPtr<const CPDF_Object> obj) {
+    if (Take(obj, kOCG)) {
+      return;
+    }
+    RetainPtr<const CPDF_Object> target = Take(std::move(obj), kOCMD);
+    const CPDF_Dictionary* ocmd = target ? target->AsDictionary() : nullptr;
+    if (!ocmd) {
+      return;
+    }
+    RetainPtr<const CPDF_Object> members = ocmd->GetObjectFor("OCGs");
+    if (!Take(members, kOCG)) {
+      GroupArray(members);
+    }
+    Expression(ocmd->GetObjectFor("VE"), 0);
+  }
+
+ private:
+  enum Kind { kArray, kUntypedDict, kOCG, kOCMD };
+  static constexpr int kMaxDepth = 32;
+
+  // Resolves `obj`; returns it if it is of `kind`, recording its object
+  // number when it is indirect (each indirect object is entered once).
+  RetainPtr<const CPDF_Object> Take(RetainPtr<const CPDF_Object> obj,
+                                    Kind kind) {
+    if (!obj) {
+      return nullptr;
+    }
+    uint32_t objnum = 0;
+    if (const CPDF_Reference* ref = ToReference(obj.Get())) {
+      objnum = ref->GetRefObjNum();
+      if (pdfium::Contains(*out_, objnum)) {
+        return nullptr;
+      }
+      obj = doc_->GetOrParseIndirectObject(objnum);
+      if (!obj) {
+        return nullptr;
+      }
+    }
+    const CPDF_Dictionary* dict = obj->AsDictionary();
+    bool accepted = false;
+    switch (kind) {
+      case kArray:
+        accepted = obj->IsArray();
+        break;
+      case kUntypedDict:
+        accepted = dict && !dict->KeyExist("Type");
+        break;
+      case kOCG:
+        accepted = dict && dict->GetNameFor("Type") == "OCG";
+        break;
+      case kOCMD:
+        accepted = dict && dict->GetNameFor("Type") == "OCMD";
+        break;
+    }
+    if (!accepted) {
+      return nullptr;
+    }
+    if (objnum) {
+      out_->insert(objnum);
+    }
+    return obj;
+  }
+
+  template <typename Fn>
+  void ForEach(const RetainPtr<const CPDF_Object>& array_obj, Fn fn) {
+    const CPDF_Array* array = array_obj->AsArray();
+    for (size_t i = 0; array && i < array->size(); ++i) {
+      fn(array->GetObjectAt(i));
+    }
+  }
+
+  void Group(RetainPtr<const CPDF_Object> obj) { Take(std::move(obj), kOCG); }
+
+  void GroupArray(RetainPtr<const CPDF_Object> obj) {
+    RetainPtr<const CPDF_Object> array = Take(std::move(obj), kArray);
+    if (array) {
+      ForEach(array, [this](RetainPtr<const CPDF_Object> e) { Group(e); });
+    }
+  }
+
+  void Order(RetainPtr<const CPDF_Object> obj, int depth) {
+    RetainPtr<const CPDF_Object> array = Take(std::move(obj), kArray);
+    if (!array || depth > kMaxDepth) {
+      return;
+    }
+    ForEach(array, [this, depth](RetainPtr<const CPDF_Object> e) {
+      if (!Take(e, kOCG)) {
+        Order(e, depth + 1);
+      }
+    });
+  }
+
+  void Expression(RetainPtr<const CPDF_Object> obj, int depth) {
+    RetainPtr<const CPDF_Object> array = Take(std::move(obj), kArray);
+    if (!array || depth > kMaxDepth) {
+      return;
+    }
+    ForEach(array, [this, depth](RetainPtr<const CPDF_Object> e) {
+      if (!Take(e, kOCG)) {
+        Expression(e, depth + 1);
+      }
+    });
+  }
+
+  void Config(RetainPtr<const CPDF_Object> obj) {
+    RetainPtr<const CPDF_Object> config = Take(std::move(obj), kUntypedDict);
+    const CPDF_Dictionary* dict = config ? config->AsDictionary() : nullptr;
+    if (!dict) {
+      return;
+    }
+    GroupArray(dict->GetObjectFor("ON"));
+    GroupArray(dict->GetObjectFor("OFF"));
+    GroupArray(dict->GetObjectFor("Locked"));
+    Order(dict->GetObjectFor("Order"), 0);
+    RetainPtr<const CPDF_Object> rb_groups =
+        Take(dict->GetObjectFor("RBGroups"), kArray);
+    if (rb_groups) {
+      ForEach(rb_groups,
+              [this](RetainPtr<const CPDF_Object> e) { GroupArray(e); });
+    }
+    RetainPtr<const CPDF_Object> auto_state =
+        Take(dict->GetObjectFor("AS"), kArray);
+    if (auto_state) {
+      ForEach(auto_state, [this](RetainPtr<const CPDF_Object> e) {
+        RetainPtr<const CPDF_Object> usage = Take(e, kUntypedDict);
+        const CPDF_Dictionary* usage_dict =
+            usage ? usage->AsDictionary() : nullptr;
+        if (usage_dict) {
+          GroupArray(usage_dict->GetObjectFor("OCGs"));
+          Take(usage_dict->GetObjectFor("Category"), kArray);
+        }
+      });
+    }
+  }
+
+  UnownedPtr<CPDF_Document> const doc_;
+  UnownedPtr<std::set<uint32_t>> const out_;
+};
+
+// g-lab-bit fork (ocg_objnums.patch): every existing indirect object an OCG
+// write call can modify: the catalog, the optional content structures (see
+// OCStructureWalker) and, for calls that update annotations, every page, its
+// /Annots array, its annotations and their /OC structures.
+std::set<uint32_t> OCWriteCandidates(CPDF_Document* doc,
+                                     bool with_annotations) {
+  std::set<uint32_t> out;
+  const CPDF_Dictionary* root = doc->GetRoot();
+  if (!root) {
+    return out;
+  }
+  if (root->GetObjNum()) {
+    out.insert(root->GetObjNum());
+  }
+  OCStructureWalker walker(doc, &out);
+  walker.Properties(root->GetObjectFor("OCProperties"));
+  if (!with_annotations) {
+    return out;
+  }
+  for (int p = 0; p < doc->GetPageCount(); ++p) {
+    RetainPtr<const CPDF_Dictionary> page = doc->GetPageDictionary(p);
+    if (!page) {
+      continue;
+    }
+    if (page->GetObjNum()) {
+      out.insert(page->GetObjNum());
+    }
+    RetainPtr<const CPDF_Object> annots_obj = page->GetObjectFor("Annots");
+    if (const CPDF_Reference* ref = ToReference(annots_obj.Get())) {
+      out.insert(ref->GetRefObjNum());
+    }
+    RetainPtr<const CPDF_Array> annots = page->GetArrayFor("Annots");
+    if (!annots) {
+      continue;
+    }
+    for (size_t i = 0; i < annots->size(); ++i) {
+      RetainPtr<const CPDF_Object> entry = annots->GetObjectAt(i);
+      if (const CPDF_Reference* ref = ToReference(entry.Get())) {
+        out.insert(ref->GetRefObjNum());
+      }
+      RetainPtr<const CPDF_Dictionary> annot = annots->GetDictAt(i);
+      if (annot) {
+        walker.Membership(annot->GetObjectFor("OC"));
+      }
+    }
+  }
+  return out;
+}
