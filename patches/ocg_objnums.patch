+ByteString SerializeForTracking(const CPDF_Object* obj) {
+  fxcrt::ostringstream buf;
+  CPDF_StringArchiveStream archive(&buf);
+  if (!obj->WriteTo(&archive, nullptr)) {
+    return ByteString();
+  }
+  return ByteString(buf);
+}
+
+}  // namespace
+
+// g-lab-bit fork (ocg_objnums.patch).
+CPDFSDK_ModifiedObjectsTracker::CPDFSDK_ModifiedObjectsTracker(
+    CPDF_Document* doc,
+    const std::set<uint32_t>& candidates)
+    : doc_(doc) {
+  doc_->SetLastModifiedObjects({});
+  const CPDF_Parser* parser = doc_->GetParser();
+  const uint32_t last_obj_num = parser ? parser->GetLastObjNum() : 0;
+  for (uint32_t objnum : candidates) {
+    if (objnum == 0 || objnum > last_obj_num) {
+      continue;  // New objects are written by reachability, not listing.
+    }
+    RetainPtr<const CPDF_Object> obj = doc_->GetOrParseIndirectObject(objnum);
+    if (obj) {
+      before_[objnum] = SerializeForTracking(obj.Get());
+    }
+  }
+}
+
+// g-lab-bit fork (ocg_objnums.patch).
+CPDFSDK_ModifiedObjectsTracker::~CPDFSDK_ModifiedObjectsTracker() {
+  std::vector<uint32_t> modified;
+  for (const auto& [objnum, serialized] : before_) {
+    RetainPtr<const CPDF_Object> obj = doc_->GetIndirectObject(objnum);
+    if (!obj || SerializeForTracking(obj.Get()) != serialized) {
+      modified.push_back(objnum);
+    }
+  }
+  doc_->SetLastModifiedObjects(std::move(modified));
+}
+
+// g-lab-bit fork (ocg_objnums.patch).
+std::set<uint32_t> CPDFSDK_AnnotHolderObjects(CPDF_AnnotContext* context) {
+  std::set<uint32_t> out;
+  if (!context) {
+    return out;
+  }
+  if (context->GetAnnotDict() && context->GetAnnotDict()->GetObjNum()) {
+    out.insert(context->GetAnnotDict()->GetObjNum());
+  }
+  CPDF_Page* page =
+      context->GetPage() ? context->GetPage()->AsPDFPage() : nullptr;
+  RetainPtr<const CPDF_Dictionary> page_dict =
+      page ? page->GetDict() : nullptr;
+  if (page_dict) {
+    if (page_dict->GetObjNum()) {
+      out.insert(page_dict->GetObjNum());
+    }
+    const CPDF_Reference* annots =
+        ToReference(page_dict->GetObjectFor("Annots").Get());
+    if (annots) {
+      out.insert(annots->GetRefObjNum());
+    }
+  }
+  return out;
+}
