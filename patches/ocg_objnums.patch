 // |annot| must come from a page of |doc|, or /OC would reference an object of
 // another document.
+// g-lab-bit fork (ocg_objnums.patch): adds the object numbers of `obj` (if
+// a reference) and of every indirect object reachable from it.
+void CollectReachableObjects(CPDF_Document* doc,
+                             RetainPtr<const CPDF_Object> obj,
+                             std::set<uint32_t>* out) {
+  std::vector<RetainPtr<const CPDF_Object>> pending;
+  pending.push_back(std::move(obj));
+  while (!pending.empty()) {
+    RetainPtr<const CPDF_Object> current = std::move(pending.back());
+    pending.pop_back();
+    if (!current) {
+      continue;
+    }
+    if (const CPDF_Reference* ref = current->AsReference()) {
+      if (out->insert(ref->GetRefObjNum()).second) {
+        pending.push_back(doc->GetOrParseIndirectObject(ref->GetRefObjNum()));
+      }
+    } else if (const CPDF_Array* array = current->AsArray()) {
+      for (size_t i = 0; i < array->size(); ++i) {
+        pending.push_back(array->GetObjectAt(i));
+      }
+    } else if (const CPDF_Dictionary* dict = current->AsDictionary()) {
+      CPDF_DictionaryLocker locker(dict);
+      for (const auto& item : locker) {
+        pending.push_back(item.second);
+      }
+    } else if (const CPDF_Stream* stream = current->AsStream()) {
+      pending.push_back(stream->GetDict());
+    }
+  }
+}
+
+// g-lab-bit fork (ocg_objnums.patch): every existing indirect object an OCG
+// write call can modify: the catalog, everything reachable from
+// /OCProperties and, for calls that update annotations, every page, its
+// /Annots array, its annotations and everything reachable from their /OC.
+std::set<uint32_t> OCWriteCandidates(CPDF_Document* doc,
+                                     bool with_annotations) {
+  std::set<uint32_t> out;
+  const CPDF_Dictionary* root = doc->GetRoot();
+  if (!root) {
+    return out;
+  }
+  if (root->GetObjNum()) {
+    out.insert(root->GetObjNum());
+  }
+  CollectReachableObjects(doc, root->GetObjectFor("OCProperties"), &out);
+  if (!with_annotations) {
+    return out;
+  }
+  for (int p = 0; p < doc->GetPageCount(); ++p) {
+    RetainPtr<const CPDF_Dictionary> page = doc->GetPageDictionary(p);
+    if (!page) {
+      continue;
+    }
+    if (page->GetObjNum()) {
+      out.insert(page->GetObjNum());
+    }
+    RetainPtr<const CPDF_Object> annots_obj = page->GetObjectFor("Annots");
+    if (const CPDF_Reference* ref = ToReference(annots_obj.Get())) {
+      out.insert(ref->GetRefObjNum());
+    }
+    RetainPtr<const CPDF_Array> annots = page->GetArrayFor("Annots");
+    if (!annots) {
+      continue;
+    }
+    for (size_t i = 0; i < annots->size(); ++i) {
+      RetainPtr<const CPDF_Object> entry = annots->GetObjectAt(i);
+      if (const CPDF_Reference* ref = ToReference(entry.Get())) {
+        out.insert(ref->GetRefObjNum());
+      }
+      RetainPtr<const CPDF_Dictionary> annot = annots->GetDictAt(i);
+      if (annot) {
+        CollectReachableObjects(doc, annot->GetObjectFor("OC"), &out);
+      }
+    }
+  }
+  return out;
+}
