+// g-lab-bit fork (annot_ocmd.patch).
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_SetOCMembership(FPDF_DOCUMENT document,
+                          FPDF_ANNOTATION annot,
+                          const int* ocg_indices,
+                          int count) {
+  auto* doc = CPDFDocumentFromFPDFDocument(document);
+  CPDF_AnnotContext* context = CPDFAnnotContextFromFPDFAnnotation(annot);
+  if (!doc || !AnnotBelongsToDoc(context, doc) || count < 0 ||
+      (count > 0 && !ocg_indices)) {
+    return false;
+  }
+  RetainPtr<CPDF_Dictionary> annot_dict = context->GetMutableAnnotDict();
+  if (!annot_dict) {
+    return false;
+  }
+  // Validate everything before changing anything.
+  std::vector<uint32_t> objnums;
+  if (count > 0) {
+    // SAFETY: required from caller.
+    auto indices =
+        UNSAFE_BUFFERS(pdfium::span(ocg_indices, static_cast<size_t>(count)));
+    for (int index : indices) {
+      RetainPtr<CPDF_Dictionary> ocg = GetMutableOCGDict(doc, index);
+      if (!ocg || ocg->GetObjNum() == 0) {
+        return false;
+      }
+      if (!pdfium::Contains(objnums, ocg->GetObjNum())) {
+        objnums.push_back(ocg->GetObjNum());
+      }
+    }
+  }
+  if (objnums.empty()) {
+    annot_dict->RemoveFor("OC");
+    return true;
+  }
+  if (objnums.size() == 1) {
+    annot_dict->SetNewFor<CPDF_Reference>("OC", doc, objnums[0]);
+    return true;
+  }
+  // A new OCMD per call; an identical existing one is not reused, so no
+  // annotation's /OC ever aliases another's (the replaced OCMD, if any, is
+  // simply no longer referenced).
+  auto ocmd = doc->NewIndirect<CPDF_Dictionary>();
+  ocmd->SetNewFor<CPDF_Name>("Type", "OCMD");
+  auto ocgs = ocmd->SetNewFor<CPDF_Array>("OCGs");
+  for (uint32_t objnum : objnums) {
+    ocgs->AppendNew<CPDF_Reference>(doc, objnum);
+  }
+  ocmd->SetNewFor<CPDF_Name>("P", "AllOn");
+  annot_dict->SetNewFor<CPDF_Reference>("OC", doc, ocmd->GetObjNum());
+  return true;
+}
