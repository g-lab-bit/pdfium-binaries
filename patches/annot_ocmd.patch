+// g-lab-bit fork (annot_ocmd.patch)
+// Experimental API.
+// Set annotation |annot|'s optional content membership to ALL of the OCGs
+// |ocg_indices| (indices into /OCProperties /OCGs, e.g. a layer and its
+// ancestors; duplicates are ignored):
+//   count == 0: /OC is removed;
+//   one distinct OCG: /OC = an indirect reference to it;
+//   more: /OC = a new indirect OCMD << /Type /OCMD /OCGs [...] /P /AllOn >>
+//         (visible only when every group is on). An identical existing OCMD
+//         is not reused, so annotations never share one through this call.
+// Nothing changes unless every index is valid and refers to an indirect OCG.
+// FPDFAnnot_GetOCGIndex() returns -1 for an OCMD. FPDFDoc_DeleteOCG() prunes a
+// deleted group from such an OCMD's /OCGs and removes /OC when none is left.
+// Note: PDFium and PDFKit ignore annotation /OC when rendering; see
+// FPDFAnnot_SetAPOptionalContent() for the appearance stream.
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_SetOCMembership(FPDF_DOCUMENT document,
+                          FPDF_ANNOTATION annot,
+                          const int* ocg_indices,
+                          int count);
+
