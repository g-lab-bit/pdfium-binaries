+// g-lab-bit fork (fork_p8.patch).
+FPDF_EXPORT int FPDF_CALLCONV FPDFDoc_DeleteOCG(FPDF_DOCUMENT document,
+                                               int index) {
+  auto* doc = CPDFDocumentFromFPDFDocument(document);
+  if (!doc) {
+    return -1;
+  }
+  RetainPtr<CPDF_Dictionary> props = GetMutableOCProperties(doc, false);
+  RetainPtr<CPDF_Array> ocgs = props ? props->GetMutableArrayFor("OCGs")
+                                     : nullptr;
+  if (!ocgs || index < 0 || static_cast<size_t>(index) >= ocgs->size()) {
+    return -1;
+  }
+  RetainPtr<const CPDF_Object> entry = ocgs->GetObjectAt(index);
+  const CPDF_Reference* entry_ref = entry ? entry->AsReference() : nullptr;
+  if (!entry_ref) {
+    return -1;  // only indirect OCGs can be referenced, and so deleted
+  }
+  const uint32_t objnum = entry_ref->GetRefObjNum();
+
+  // 1. The group list and every configuration (/D and /Configs).
+  RemoveOCGRef(ocgs.Get(), objnum);
+  RemoveOCGFromConfig(props->GetMutableDictFor("D").Get(), objnum);
+  RetainPtr<CPDF_Array> configs = props->GetMutableArrayFor("Configs");
+  if (configs) {
+    for (size_t i = 0; i < configs->size(); ++i) {
+      RemoveOCGFromConfig(configs->GetMutableDictAt(i).Get(), objnum);
+    }
+  }
+
+  // 2. Annotations still pointing at it — directly or via an OCMD's /OCGs.
+  // The caller re-homes the annotations it cares about first; anything left
+  // becomes always-visible rather than referencing a group that is gone.
+  // An OCMD may be shared by several annotations: prune it once, count every
+  // annotation that uses it.
+  int touched = 0;
+  std::set<const CPDF_Dictionary*> pruned_ocmds;
+  for (int p = 0; p < doc->GetPageCount(); ++p) {
+    RetainPtr<CPDF_Dictionary> page = doc->GetMutablePageDictionary(p);
+    RetainPtr<CPDF_Array> annots = page ? page->GetMutableArrayFor("Annots")
+                                        : nullptr;
+    if (!annots) {
+      continue;
+    }
+    for (size_t i = 0; i < annots->size(); ++i) {
+      RetainPtr<CPDF_Dictionary> annot = annots->GetMutableDictAt(i);
+      RetainPtr<const CPDF_Object> oc = annot ? annot->GetObjectFor("OC")
+                                              : nullptr;
+      if (!oc) {
+        continue;
+      }
+      const CPDF_Reference* oc_ref = oc->AsReference();
+      if (oc_ref && oc_ref->GetRefObjNum() == objnum) {
+        annot->RemoveFor("OC");
+        ++touched;
+        continue;
+      }
+      RetainPtr<CPDF_Dictionary> ocmd = annot->GetMutableDictFor("OC");
+      if (!ocmd || ocmd->GetNameFor("Type") != "OCMD") {
+        continue;
+      }
+      if (pruned_ocmds.count(ocmd.Get())) {  // shared OCMD already pruned
+        ++touched;
+        RetainPtr<const CPDF_Array> left = ocmd->GetArrayFor("OCGs");
+        if (!left || left->IsEmpty()) {
+          annot->RemoveFor("OC");
+        }
+        continue;
+      }
+      RetainPtr<CPDF_Object> members = ocmd->GetMutableDirectObjectFor("OCGs");
+      if (!members) {
+        continue;
+      }
+      if (CPDF_Array* list = members->AsMutableArray()) {
+        const size_t before = list->size();
+        RemoveOCGRef(list, objnum);
+        if (list->size() != before) {
+          pruned_ocmds.insert(ocmd.Get());
+          ++touched;
+          if (list->IsEmpty()) {
+            annot->RemoveFor("OC");
+          }
+        }
+      } else if (members->GetObjNum() == objnum) {
+        pruned_ocmds.insert(ocmd.Get());
+        annot->RemoveFor("OC");
+        ++touched;
+      }
+    }
+  }
+  // Not handled (documented in fpdf_doc.h): OCG references from page or
+  // XObject /Properties (marked content), /OC on form or image XObjects, and
+  // OCMD /VE visibility expressions. Rapida only deletes groups it created,
+  // which are referenced from annotations and configurations alone.
+  return touched;
+}
