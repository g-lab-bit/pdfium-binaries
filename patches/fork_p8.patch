+// g-lab-bit fork (fork_p8.patch).
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_GetLineEndings(FPDF_ANNOTATION annot,
+                         char* start_buffer,
+                         char* end_buffer,
+                         unsigned long buflen) {
+  if (!start_buffer || !end_buffer || buflen == 0) {
+    return false;
+  }
+  if (FPDFAnnot_GetSubtype(annot) != FPDF_ANNOT_LINE) {
+    return false;
+  }
+  const CPDF_Dictionary* annot_dict = GetAnnotDictFromFPDFAnnotation(annot);
+  if (!annot_dict) {
+    return false;
+  }
+  // Absent /LE (or a short array) means "None" for that end (PDF 32000 Table 175).
+  RetainPtr<const CPDF_Array> le = annot_dict->GetArrayFor("LE");
+  const ByteString start = le && le->size() > 0 ? le->GetByteStringAt(0) : "None";
+  const ByteString end = le && le->size() > 1 ? le->GetByteStringAt(1) : "None";
+  if (start.GetLength() + 1 > buflen || end.GetLength() + 1 > buflen) {
+    return false;
+  }
+  // SAFETY: required from caller (both buffers hold |buflen| bytes).
+  NulTerminateMaybeCopyAndReturnLength(
+      start, UNSAFE_BUFFERS(SpanFromFPDFApiArgs(start_buffer, buflen)));
+  NulTerminateMaybeCopyAndReturnLength(
+      end, UNSAFE_BUFFERS(SpanFromFPDFApiArgs(end_buffer, buflen)));
+  return true;
+}
