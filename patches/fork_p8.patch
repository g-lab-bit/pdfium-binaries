+// edit Rapida's styles. None of these touch /AP: the caller rebuilds it.
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_SetBorderStyle(FPDF_ANNOTATION annot,
+                         float width,
+                         FPDF_BYTESTRING style,
+                         const float* dash,
+                         unsigned long dash_count) {
+  RetainPtr<CPDF_Dictionary> annot_dict =
+      GetMutableAnnotDictFromFPDFAnnotation(annot);
+  if (!annot_dict || !style || !std::isfinite(width) || width < 0 ||
+      (dash_count > 0 && !dash) || dash_count > 16) {
+    return false;
+  }
+  const ByteStringView s(style);
+  if (s != "S" && s != "D" && s != "B" && s != "I" && s != "U") {
+    return false;
+  }
+  for (unsigned long i = 0; i < dash_count; ++i) {
+    // SAFETY: required from caller (|dash| holds |dash_count| floats).
+    const float v = UNSAFE_BUFFERS(dash[i]);
+    if (!std::isfinite(v) || v < 0) {
+      return false;
+    }
+  }
+  auto bs = annot_dict->SetNewFor<CPDF_Dictionary>("BS");
+  bs->SetNewFor<CPDF_Name>("Type", "Border");
+  bs->SetNewFor<CPDF_Number>("W", width);
+  bs->SetNewFor<CPDF_Name>("S", ByteString(s));
+  if (dash_count > 0) {
+    auto d = bs->SetNewFor<CPDF_Array>("D");
+    for (unsigned long i = 0; i < dash_count; ++i) {
+      d->AppendNew<CPDF_Number>(UNSAFE_BUFFERS(dash[i]));
+    }
+  }
+  // /BS takes precedence over the legacy /Border array; drop it so readers
+  // that consult /Border first do not disagree.
+  annot_dict->RemoveFor(pdfium::annotation::kBorder);
+  return true;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_GetBorderStyleWidth(FPDF_ANNOTATION annot, float* width) {
+  const CPDF_Dictionary* annot_dict = GetAnnotDictFromFPDFAnnotation(annot);
+  if (!annot_dict || !width) {
+    return false;
+  }
+  RetainPtr<const CPDF_Dictionary> bs = annot_dict->GetDictFor("BS");
+  *width = bs && bs->KeyExist("W") ? bs->GetFloatFor("W") : 1.0f;  // default 1
+  return true;
+}
+
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDFAnnot_GetBorderStyleName(FPDF_ANNOTATION annot,
+                             char* buffer,
+                             unsigned long buflen) {
+  const CPDF_Dictionary* annot_dict = GetAnnotDictFromFPDFAnnotation(annot);
+  if (!annot_dict) {
+    return 0;
+  }
+  RetainPtr<const CPDF_Dictionary> bs = annot_dict->GetDictFor("BS");
+  const ByteString s = bs && bs->KeyExist("S") ? bs->GetNameFor("S") : "S";
+  // SAFETY: required from caller.
+  return NulTerminateMaybeCopyAndReturnLength(
+      s, UNSAFE_BUFFERS(SpanFromFPDFApiArgs(buffer, buflen)));
+}
+
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDFAnnot_GetBorderDash(FPDF_ANNOTATION annot,
+                        float* values,
+                        unsigned long count) {
+  const CPDF_Dictionary* annot_dict = GetAnnotDictFromFPDFAnnotation(annot);
+  if (!annot_dict) {
+    return 0;
+  }
+  RetainPtr<const CPDF_Dictionary> bs = annot_dict->GetDictFor("BS");
+  RetainPtr<const CPDF_Array> d = bs ? bs->GetArrayFor("D") : nullptr;
+  if (!d) {
+    // Default dash array [3] (Table 168).
+    if (values && count >= 1) {
+      UNSAFE_BUFFERS(values[0]) = 3.0f;
+    }
+    return 1;
+  }
+  const unsigned long len = pdfium::checked_cast<unsigned long>(d->size());
+  if (values && count >= len) {
+    for (unsigned long i = 0; i < len; ++i) {
+      // SAFETY: required from caller (|values| holds |count| floats).
+      UNSAFE_BUFFERS(values[i]) = d->GetFloatAt(i);
+    }
+  }
+  return len;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_SetBorderEffect(FPDF_ANNOTATION annot,
+                          FPDF_BYTESTRING style,
+                          float intensity) {
+  RetainPtr<CPDF_Dictionary> annot_dict =
+      GetMutableAnnotDictFromFPDFAnnotation(annot);
+  if (!annot_dict || !style || !std::isfinite(intensity) || intensity < 0 ||
+      intensity > 2) {
+    return false;
+  }
+  const ByteStringView s(style);
+  if (s != "S" && s != "C") {
+    return false;
+  }
+  if (s == "S") {  // no effect: the default, so drop /BE
+    annot_dict->RemoveFor("BE");
+    return true;
+  }
+  auto be = annot_dict->SetNewFor<CPDF_Dictionary>("BE");
+  be->SetNewFor<CPDF_Name>("S", ByteString(s));
+  be->SetNewFor<CPDF_Number>("I", intensity);
+  return true;
+}
+
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDFAnnot_GetBorderEffect(FPDF_ANNOTATION annot,
+                          char* buffer,
+                          unsigned long buflen,
+                          float* intensity) {
+  const CPDF_Dictionary* annot_dict = GetAnnotDictFromFPDFAnnotation(annot);
+  if (!annot_dict) {
+    return 0;
+  }
+  RetainPtr<const CPDF_Dictionary> be = annot_dict->GetDictFor("BE");
+  const ByteString s = be && be->KeyExist("S") ? be->GetNameFor("S") : "S";
+  if (intensity) {
+    *intensity = be && be->KeyExist("I") ? be->GetFloatFor("I") : 0.0f;
+  }
+  // SAFETY: required from caller.
+  return NulTerminateMaybeCopyAndReturnLength(
+      s, UNSAFE_BUFFERS(SpanFromFPDFApiArgs(buffer, buflen)));
+}
