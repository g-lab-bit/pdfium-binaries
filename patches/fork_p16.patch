+// g-lab-bit fork (annot_tracker_scope.patch).
+CPDFSDK_ModifiedObjectsTracker::CPDFSDK_ModifiedObjectsTracker(
+    CPDF_Document* doc,
+    CPDF_AnnotContext* context)
+    : doc_(doc) {
+  doc_->SetLastModifiedObjects({});
+  RetainPtr<const CPDF_Dictionary> dict =
+      context ? pdfium::WrapRetain(context->GetAnnotDict()) : nullptr;
+  if (!dict) {
+    return;
+  }
+  const CPDF_Parser* parser = doc_->GetParser();
+  const uint32_t last_obj_num = parser ? parser->GetLastObjNum() : 0;
+  const uint32_t objnum = dict->GetObjNum();
+  if (objnum) {
+    // Indirect: its holders list it by reference, which an edit of the
+    // dictionary never changes.
+    if (objnum <= last_obj_num) {
+      before_[objnum] = SerializeForTracking(dict.Get());
+    }
+    return;
+  }
+  // Direct: inside the page's /Annots array.
+  CPDF_Page* page =
+      context->GetPage() ? context->GetPage()->AsPDFPage() : nullptr;
+  RetainPtr<const CPDF_Dictionary> page_dict = page ? page->GetDict() : nullptr;
+  if (!page_dict) {
+    return;
+  }
+  const CPDF_Reference* annots =
+      ToReference(page_dict->GetObjectFor("Annots").Get());
+  const uint32_t holder = annots ? annots->GetRefObjNum() : page_dict->GetObjNum();
+  if (holder == 0 || holder > last_obj_num) {
+    return;  // a new holder is written by reachability, not listing
+  }
+  watched_ = dict;
+  watched_before_ = SerializeForTracking(dict.Get());
+  watched_holder_ = holder;
+}
+
 CPDFSDK_ModifiedObjectsTracker::~CPDFSDK_ModifiedObjectsTracker() {
   std::vector<uint32_t> modified;
   for (const auto& [objnum, serialized] : before_) {
@@ -250,6 +290,9 @@ CPDFSDK_ModifiedObjectsTracker::~CPDFSDK_ModifiedObjectsTracker() {
       modified.push_back(objnum);
     }
   }
+  if (watched_ && SerializeForTracking(watched_.Get()) != watched_before_) {
+    modified.push_back(watched_holder_);   // annot_tracker_scope.patch
+  }
   doc_->SetLastModifiedObjects(std::move(modified));
 }
 
