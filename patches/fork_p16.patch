+// g-lab-bit fork (object_syntax_api.patch): read / write one key of an
+// annotation or page dictionary as PDF object syntax — /CL, /IT, /Measure
+// (annotations) and /VP (pages) for Rapida's callouts and measurements.
+namespace {
+
+constexpr size_t kMaxObjectSyntax = 1 << 16;
+
+// Only direct objects: no references (they could point anywhere), no streams.
+bool IsDirectValue(const CPDF_Object* obj, int depth) {
+  if (!obj || depth > 32 || obj->IsReference() || obj->IsStream()) {
+    return false;
+  }
+  if (const CPDF_Array* array = obj->AsArray()) {
+    for (size_t i = 0; i < array->size(); ++i) {
+      if (!IsDirectValue(array->GetObjectAt(i).Get(), depth + 1)) {
+        return false;
+      }
+    }
+  } else if (const CPDF_Dictionary* dict = obj->AsDictionary()) {
+    CPDF_DictionaryLocker locker(dict);
+    for (const auto& it : locker) {
+      if (!IsDirectValue(it.second.Get(), depth + 1)) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+// |syntax| as one direct object, or nullptr (empty, malformed, trailing text,
+// a reference or a stream inside).
+RetainPtr<CPDF_Object> ParseDirectObject(ByteStringView syntax) {
+  if (syntax.IsEmpty() || syntax.GetLength() > kMaxObjectSyntax) {
+    return nullptr;
+  }
+  ByteString copy(syntax);   // the stream reads from it while it is in scope
+  auto parser = std::make_unique<CPDF_SyntaxParser>(
+      pdfium::MakeRetain<CFX_ReadOnlySpanStream>(copy.unsigned_span()));
+  RetainPtr<CPDF_Object> obj = parser->GetObjectBody(nullptr);
+  if (!obj || obj->IsNull() || !IsDirectValue(obj.Get(), 0)) {
+    return nullptr;
+  }
+  // Nothing after it but white space.
+  for (FX_FILESIZE p = parser->GetPos(); p < static_cast<FX_FILESIZE>(copy.GetLength()); ++p) {
+    if (!PDFCharIsWhitespace(static_cast<uint8_t>(copy[static_cast<size_t>(p)]))) {
+      return nullptr;
+    }
+  }
+  return obj;
+}
+
+unsigned long WriteSyntax(const CPDF_Object* obj, char* buffer, unsigned long buflen) {
+  if (!obj) {
+    return 0;
+  }
+  fxcrt::ostringstream buf;
+  CPDF_StringArchiveStream archive(&buf);
+  if (!obj->WriteTo(&archive, nullptr)) {
+    return 0;
+  }
+  // SAFETY: required from caller.
+  return NulTerminateMaybeCopyAndReturnLength(
+      ByteString(buf), UNSAFE_BUFFERS(SpanFromFPDFApiArgs(buffer, buflen)));
+}
+
+// Keys the API never touches: the dictionaries' structure.
+bool IsReservedAnnotKey(ByteStringView key) {
+  return key == "Type" || key == "Subtype" || key == "P" || key == "Parent" ||
+         key == "AP" || key == "Popup" || key == "IRT";
+}
+bool IsReservedPageKey(ByteStringView key) {
+  return key == "Type" || key == "Parent" || key == "Contents" ||
+         key == "Resources" || key == "Annots" || key == "Kids";
+}
+
+}  // namespace
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_SetObjectSyntax(FPDF_DOCUMENT document,
+                          FPDF_ANNOTATION annot,
+                          FPDF_BYTESTRING key,
+                          FPDF_BYTESTRING syntax) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  CPDF_AnnotContext* context = CPDFAnnotContextFromFPDFAnnotation(annot);
+  if (doc) {
+    doc->SetLastModifiedObjects({});
+  }
+  if (!doc || !context || !context->GetPage() ||
+      context->GetPage()->GetDocument() != doc || !key || !*key ||
+      IsReservedAnnotKey(key)) {
+    return false;
+  }
+  RetainPtr<CPDF_Dictionary> dict = context->GetMutableAnnotDict();
+  if (!dict) {
+    return false;
+  }
+  RetainPtr<CPDF_Object> value;
+  if (syntax && *syntax) {
+    value = ParseDirectObject(syntax);
+    if (!value) {
+      return false;
+    }
+  }
+  CPDFSDK_ModifiedObjectsTracker tracker(doc, context);
+  if (value) {
+    dict->SetFor(key, std::move(value));
+  } else {
+    dict->RemoveFor(key);
+  }
+  return true;
+}
+
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDFAnnot_GetObjectSyntax(FPDF_ANNOTATION annot,
+                          FPDF_BYTESTRING key,
+                          char* buffer,
+                          unsigned long buflen) {
+  CPDF_AnnotContext* context = CPDFAnnotContextFromFPDFAnnotation(annot);
+  if (!context || !key || !*key) {
+    return 0;
+  }
+  const CPDF_Dictionary* dict = context->GetAnnotDict();
+  return dict ? WriteSyntax(dict->GetObjectFor(key).Get(), buffer, buflen) : 0;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFPage_SetObjectSyntax(FPDF_DOCUMENT document,
+                         FPDF_PAGE page,
+                         FPDF_BYTESTRING key,
+                         FPDF_BYTESTRING syntax) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  CPDF_Page* pdf_page = CPDFPageFromFPDFPage(page);
+  if (doc) {
+    doc->SetLastModifiedObjects({});
+  }
+  if (!doc || !pdf_page || pdf_page->GetDocument() != doc || !key || !*key ||
+      IsReservedPageKey(key)) {
+    return false;
+  }
+  RetainPtr<CPDF_Dictionary> dict = pdf_page->GetMutableDict();
+  if (!dict) {
+    return false;
+  }
+  RetainPtr<CPDF_Object> value;
+  if (syntax && *syntax) {
+    value = ParseDirectObject(syntax);
+    if (!value) {
+      return false;
+    }
+  }
+  std::set<uint32_t> candidates;
+  if (dict->GetObjNum()) {
+    candidates.insert(dict->GetObjNum());
+  }
+  CPDFSDK_ModifiedObjectsTracker tracker(doc, candidates);
+  if (value) {
+    dict->SetFor(key, std::move(value));
+  } else {
+    dict->RemoveFor(key);
+  }
+  return true;
+}
+
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDFPage_GetObjectSyntax(FPDF_PAGE page,
+                         FPDF_BYTESTRING key,
+                         char* buffer,
+                         unsigned long buflen) {
+  CPDF_Page* pdf_page = CPDFPageFromFPDFPage(page);
+  if (!pdf_page || !key || !*key) {
+    return 0;
+  }
+  RetainPtr<const CPDF_Dictionary> dict = pdf_page->GetDict();
+  return dict ? WriteSyntax(dict->GetObjectFor(key).Get(), buffer, buflen) : 0;
+}
+
