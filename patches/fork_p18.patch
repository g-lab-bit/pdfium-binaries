 }
 
+// g-lab-bit fork-p18 (annot_render_hide).
+void CPDF_Document::SetAnnotRenderHidden(RetainPtr<const CPDF_Dictionary> annot,
+                                         bool hidden) {
+  if (!annot) {
+    return;
+  }
+  if (hidden) {
+    const CPDF_Dictionary* key = annot.Get();
+    render_hidden_annots_[key] = std::move(annot);
+  } else {
+    render_hidden_annots_.erase(annot.Get());
+  }
+}
+
+// g-lab-bit fork-p18 (annot_render_hide).
+// A popup is hidden with its parent markup.
+bool CPDF_Document::IsAnnotRenderHidden(const CPDF_Dictionary* annot) const {
+  if (!annot || render_hidden_annots_.empty()) {
+    return false;
+  }
+  if (render_hidden_annots_.count(annot) > 0) {
+    return true;
+  }
+  if (annot->GetNameFor("Subtype") != "Popup") {
+    return false;
+  }
+  RetainPtr<const CPDF_Dictionary> parent = annot->GetDictFor("Parent");
+  return parent && render_hidden_annots_.count(parent.Get()) > 0;
+}
+
 int CPDF_Document::GetPageCount() const {
   return fxcrt::CollectionSize<int>(page_list_);
 }
