+// g-lab-bit fork-p18 (annot_render_hide).
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_SetRenderHidden(FPDF_DOCUMENT document,
+                          FPDF_ANNOTATION annot,
+                          FPDF_BOOL hidden) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  CPDF_AnnotContext* context = CPDFAnnotContextFromFPDFAnnotation(annot);
+  if (!AnnotInDoc(doc, context) || !context->GetAnnotDict()) {
+    return false;
+  }
+  doc->SetAnnotRenderHidden(context->GetMutableAnnotDict(), !!hidden);
+  return true;
+}
+
+// g-lab-bit fork-p18 (annot_render_hide).
+FPDF_EXPORT void FPDF_CALLCONV
+FPDFDoc_ClearRenderHiddenAnnots(FPDF_DOCUMENT document) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  if (doc) {
+    doc->ClearAnnotRenderHidden();
+  }
+}
