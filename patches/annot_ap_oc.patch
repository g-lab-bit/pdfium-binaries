+// g-lab-bit fork (annot_ap_oc.patch).
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_SetAPOptionalContent(FPDF_DOCUMENT document,
+                               FPDF_ANNOTATION annot,
+                               FPDF_ANNOT_APPEARANCEMODE appearance_mode,
+                               const int* ocg_indices,
+                               int count) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  CPDF_AnnotContext* context = CPDFAnnotContextFromFPDFAnnotation(annot);
+  if (!doc || !context || !context->GetPage() ||
+      context->GetPage()->GetDocument() != doc ||
+      appearance_mode != FPDF_ANNOT_APPEARANCEMODE_NORMAL || count < 0 ||
+      (count > 0 && !ocg_indices) ||
+      !FPDFAnnot_IsObjectSupportedSubtype(FPDFAnnot_GetSubtype(annot))) {
+    return false;
+  }
+  RetainPtr<CPDF_Dictionary> annot_dict = context->GetMutableAnnotDict();
+  RetainPtr<CPDF_Stream> stream =
+      GetAnnotAP(annot_dict.Get(), CPDF_Annot::AppearanceMode::kNormal);
+  // The AP must have its own /Resources (FPDFAnnot_AppendObject creates
+  // them); adding one would cut it off from names it may inherit.
+  RetainPtr<CPDF_Dictionary> resources =
+      stream ? stream->GetMutableDict()->GetMutableDictFor("Resources")
+             : nullptr;
+  if (!resources) {
+    return false;
+  }
+
+  // Validate every index before changing anything.
+  std::vector<uint32_t> objnums;
+  if (count > 0) {
+    const CPDF_Dictionary* root = doc->GetRoot();
+    RetainPtr<const CPDF_Dictionary> oc_properties =
+        root ? root->GetDictFor("OCProperties") : nullptr;
+    RetainPtr<const CPDF_Array> ocgs =
+        oc_properties ? oc_properties->GetArrayFor("OCGs") : nullptr;
+    // SAFETY: required from caller.
+    auto indices =
+        UNSAFE_BUFFERS(pdfium::span(ocg_indices, static_cast<size_t>(count)));
+    for (int index : indices) {
+      RetainPtr<const CPDF_Dictionary> ocg =
+          ocgs && index >= 0 && static_cast<size_t>(index) < ocgs->size()
+              ? ocgs->GetDictAt(index)
+              : nullptr;
+      if (!ocg || ocg->GetObjNum() == 0) {
+        return false;
+      }
+      if (!pdfium::Contains(objnums, ocg->GetObjNum())) {
+        objnums.push_back(ocg->GetObjNum());
+      }
+    }
+  }
+
+  if (!context->HasForm()) {
+    context->SetForm(stream);
+  }
+  CPDF_Form* form = context->GetForm();
+
+  // One /Properties entry per group, then nested /OC marks on every object
+  // of the appearance, outermost first (ocg_indices[0]); the content
+  // generator writes them as "/OC /OCGn BDC ... EMC".
+  std::vector<ByteString> names;
+  RetainPtr<CPDF_Dictionary> properties;
+  if (!objnums.empty()) {
+    properties = resources->GetOrCreateDictFor("Properties");
+    for (uint32_t objnum : objnums) {
+      ByteString name = ByteString::Format("OCG%u", objnum);
+      properties->SetNewFor<CPDF_Reference>(name, doc, objnum);
+      names.push_back(std::move(name));
+    }
+  }
+  for (auto& page_object : *form) {
+    CPDF_ContentMarks* marks = page_object->GetContentMarks();
+    for (size_t i = marks->CountItems(); i > 0; --i) {
+      CPDF_ContentMarkItem* item = marks->GetItem(i - 1);
+      if (item->GetName() == "OC") {
+        marks->RemoveMark(item);
+      }
+    }
+    for (const ByteString& name : names) {
+      marks->AddMarkWithPropertiesHolder("OC", properties, name);
+    }
+  }
+  UpdateContentStream(form, stream.Get());
+  return true;
+}
