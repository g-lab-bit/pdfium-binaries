+// in-memory document. A subsequent FPDF_SaveAsCopy() persists them.
+
+// Experimental API.
+// Create a new optional content group named |name| (UTF-16LE, NUL-terminated)
+// as an indirect /Type /OCG dictionary, append it to /OCProperties /OCGs
+// (creating /OCProperties with an empty /D if absent) and, when the default
+// configuration has an /Order array, to that /Order.
+// Returns the new OCG's index (as used by FPDFDoc_GetOCG*), or -1 on error.
+FPDF_EXPORT int FPDF_CALLCONV FPDFDoc_CreateOCG(FPDF_DOCUMENT document,
+                                               FPDF_WIDESTRING name);
+
+// Experimental API.
+// Set |key| in OCG |index|'s dictionary to a text string (UTF-16LE,
+// NUL-terminated), e.g. "Name" or "RapidaLayerId".
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFDoc_SetOCGStringValue(FPDF_DOCUMENT document,
+                          int index,
+                          FPDF_BYTESTRING key,
+                          FPDF_WIDESTRING value);
+
+// Experimental API.
+// Set |key| in OCG |index|'s dictionary to a number.
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFDoc_SetOCGNumberValue(FPDF_DOCUMENT document,
+                          int index,
+                          FPDF_BYTESTRING key,
+                          float value);
+
+// Experimental API.
+// Set |key| in OCG |index|'s dictionary to an array of |count| numbers.
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFDoc_SetOCGNumberArray(FPDF_DOCUMENT document,
+                          int index,
+                          FPDF_BYTESTRING key,
+                          const float* values,
+                          int count);
+
+// Experimental API.
+// Make OCG |index| visible or hidden under the default configuration
