+// /OFF. The OCG must be an indirect object.
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFDoc_SetOCGDefaultVisibility(FPDF_DOCUMENT document,
+                                int index,
+                                FPDF_BOOL visible);
+
+// Experimental API.
+// Set annotation |annot|'s /OC entry to an indirect reference to OCG |index|,
