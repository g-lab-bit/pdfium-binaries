@@ -285,6 +286,19 @@ void CPDF_AnnotList::DisplayPass(CPDF_RenderContext* context,
       continue;
     }
 
+    // g-lab-bit fork (annot_oc_render.patch): an annotation in optional
+    // content (/OC: an OCG or an OCMD, ISO 32000-1 8.11.3.3) is drawn only
+    // when that is on for the render's usage — View including the document's
