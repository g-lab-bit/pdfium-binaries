+// g-lab-bit fork (annot_number_array.patch)
+// Experimental API.
+// Read an array of numbers from the annotation dictionary, e.g. /C or /IC
+// (colour components), regardless of whether the annotation has an
+// appearance stream (FPDFAnnot_GetColor() fails when /AP exists). Nothing is
+// modified and no object is added to the document's object map (an indirect
+// array or element that is not loaded yet is read without being stored).
+//
+//   annot   - handle to an annotation.
+//   key     - the dictionary key, e.g. "C" or "IC".
+//   values  - buffer receiving the first min(n, count) numbers; may be NULL.
+//   count   - number of floats |values| can hold; 0 (or NULL |values|)
+//             queries the size only.
+//
+// Returns the number of elements n if |key| holds a (direct or indirect)
+// array whose elements are all numbers (n may be 0), or -1 if the key is
+// absent, is not an array, or holds a non-numeric element.
+FPDF_EXPORT int FPDF_CALLCONV FPDFAnnot_GetNumberArray(FPDF_ANNOTATION annot,
+                                                       FPDF_BYTESTRING key,
+                                                       float* values,
+                                                       unsigned long count);
