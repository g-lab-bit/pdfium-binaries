+// g-lab-bit fork (annot_number_array.patch).
+namespace {
+
+// Resolves `obj` without adding anything to the document's object map: an
+// already loaded object is used as is, otherwise the parser returns a copy
+// that is not stored.
+RetainPtr<const CPDF_Object> ResolveWithoutLoading(
+    CPDF_Document* doc,
+    RetainPtr<const CPDF_Object> obj) {
+  const CPDF_Reference* ref = ToReference(obj.Get());
+  if (!ref) {
+    return obj;
+  }
+  if (!doc) {
+    return nullptr;
+  }
+  RetainPtr<const CPDF_Object> loaded =
+      doc->GetIndirectObject(ref->GetRefObjNum());
+  if (loaded) {
+    return loaded;
+  }
+  CPDF_Parser* parser = doc->GetParser();
+  return parser ? parser->ParseIndirectObject(ref->GetRefObjNum()) : nullptr;
+}
+
+}  // namespace
+
+FPDF_EXPORT int FPDF_CALLCONV FPDFAnnot_GetNumberArray(FPDF_ANNOTATION annot,
+                                                       FPDF_BYTESTRING key,
+                                                       float* values,
+                                                       unsigned long count) {
+  const CPDF_AnnotContext* context = CPDFAnnotContextFromFPDFAnnotation(annot);
+  const CPDF_Dictionary* annot_dict =
+      context ? context->GetAnnotDict() : nullptr;
+  if (!annot_dict || !key) {
+    return -1;
+  }
+  // Read-only, and /AP is not consulted.
+  CPDF_Document* doc =
+      context->GetPage() ? context->GetPage()->GetDocument() : nullptr;
+  RetainPtr<const CPDF_Object> value =
+      ResolveWithoutLoading(doc, annot_dict->GetObjectFor(key));
+  const CPDF_Array* array = value ? value->AsArray() : nullptr;
+  if (!array || array->size() > static_cast<size_t>(INT_MAX)) {
+    return -1;
+  }
+  std::vector<float> numbers;
+  numbers.reserve(array->size());
+  for (size_t i = 0; i < array->size(); ++i) {
+    RetainPtr<const CPDF_Object> element =
+        ResolveWithoutLoading(doc, array->GetObjectAt(i));
+    if (!element || !element->IsNumber()) {
+      return -1;
+    }
+    numbers.push_back(element->GetNumber());
+  }
+  if (values && count) {
+    // SAFETY: required from caller.
+    auto out = UNSAFE_BUFFERS(pdfium::span(values, count));
+    const size_t n = std::min<size_t>(numbers.size(), out.size());
+    for (size_t i = 0; i < n; ++i) {
+      out[i] = numbers[i];
+    }
+  }
+  return static_cast<int>(numbers.size());
+}
