+// g-lab-bit fork (filter_unchanged.patch).
+FPDF_EXPORT int FPDF_CALLCONV
+FPDF_FilterUnchangedObjects(FPDF_DOCUMENT document,
+                            uint32_t* objnums,
+                            int count) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  if (!doc || count < 0 || (count > 0 && !objnums)) {
+    return -1;
+  }
+  CPDF_Parser* parser = doc->GetParser();
+  if (!parser || count == 0) {
+    return count;  // No original file: nothing can be unchanged.
+  }
+  // Originals are parsed by the parser directly: a decrypted copy that is
+  // not stored in the document's object map.
+  SaveVerifier verifier(doc, [parser](uint32_t objnum) {
+    return RetainPtr<const CPDF_Object>(parser->ParseIndirectObject(objnum));
+  });
+  const uint32_t last_obj_num = parser->GetLastObjNum();
+  // SAFETY: required from caller.
+  auto list = UNSAFE_BUFFERS(pdfium::span(objnums, static_cast<size_t>(count)));
+  size_t kept = 0;
+  for (size_t i = 0; i < list.size(); ++i) {
+    const uint32_t objnum = list[i];
+    bool unchanged = false;
+    if (objnum != 0 && objnum <= last_obj_num) {
+      // Only a loaded object can have been changed.
+      RetainPtr<const CPDF_Object> current = doc->GetIndirectObject(objnum);
+      if (!current) {
+        unchanged = true;
+      } else {
+        RetainPtr<const CPDF_Object> original =
+            parser->ParseIndirectObject(objnum);
+        unchanged =
+            original && verifier.ObjectsEqual(current.Get(), original.Get(), 0);
+      }
+    }
+    if (!unchanged) {
+      list[kept++] = objnum;
+    }
+  }
+  return pdfium::checked_cast<int>(kept);
+}
