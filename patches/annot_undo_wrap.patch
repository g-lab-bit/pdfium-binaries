+FPDF_EXPORT int FPDF_CALLCONV FPDFAnnot_SaveState(FPDF_DOCUMENT document,
+                                                 FPDF_ANNOTATION annot) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  CPDF_AnnotContext* context = CPDFAnnotContextFromFPDFAnnotation(annot);
+  if (!AnnotInDoc(doc, context) || !context->GetAnnotDict()) {
+    return 0;
+  }
+  RetainPtr<CPDF_Dictionary> dict = context->GetMutableAnnotDict();
+  RetainPtr<CPDF_Dictionary> copy = ToDictionary(dict->Clone());
+  if (!copy) {
+    return 0;
+  }
+  const uint32_t objnum = dict->GetObjNum();
+  return doc->AddAnnotState({std::move(copy), std::move(dict), objnum});
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_RestoreState(FPDF_DOCUMENT document, FPDF_ANNOTATION annot, int id) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  CPDF_AnnotContext* context = CPDFAnnotContextFromFPDFAnnotation(annot);
+  if (doc) {
+    doc->SetLastModifiedObjects({});  // ocg_objnums.patch
+  }
+  if (!AnnotInDoc(doc, context)) {
+    return false;
+  }
+  CPDF_Document::AnnotState* state = doc->GetAnnotState(id);
+  RetainPtr<CPDF_Dictionary> dict = context->GetMutableAnnotDict();
+  // The same annotation: the same dictionary object (direct annotations all
+  // have object number 0, so the number alone cannot tell them apart).
+  if (!state || !dict || state->source.Get() != dict.Get()) {
+    return false;
+  }
+  CPDFSDK_ModifiedObjectsTracker tracker(doc,
+                                         CPDFSDK_AnnotHolderObjects(context));
+  ReplaceDictContents(dict.Get(), state->dict.Get());
+  return true;
+}
+
+FPDF_EXPORT int FPDF_CALLCONV FPDFPage_InsertAnnotState(FPDF_DOCUMENT document,
+                                                       FPDF_PAGE page,
+                                                       int id,
+                                                       int index) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  CPDF_Page* pPage = CPDFPageFromFPDFPage(page);
+  if (doc) {
+    doc->SetLastModifiedObjects({});  // ocg_objnums.patch
+  }
+  if (!doc || !pPage || pPage->GetDocument() != doc) {
+    return -1;
+  }
+  CPDF_Document::AnnotState* state = doc->GetAnnotState(id);
+  if (!state || state->inserted) {
+    return -1;  // unknown, or already put back once
+  }
+  RetainPtr<const CPDF_Dictionary> page_dict = pPage->GetDict();
+  // Only onto its own page (an annotation belongs to one page, /P).
+  const CPDF_Reference* p_ref = ToReference(state->dict->GetObjectFor("P").Get());
+  if (p_ref && page_dict && page_dict->GetObjNum() &&
+      p_ref->GetRefObjNum() != page_dict->GetObjNum()) {
+    return -1;
+  }
+  // The same object: an indirect annotation's object if it still exists and
+  // this page does not already list it; a direct annotation's own dictionary
+  // (kept alive by the state), so every other state saved for it stays valid.
+  RetainPtr<CPDF_Dictionary> target;
+  if (state->objnum) {
+    target = ToDictionary(doc->GetOrParseIndirectObject(state->objnum));
+    RetainPtr<const CPDF_Array> current = pPage->GetAnnotsArray();
+    for (size_t i = 0; target && current && i < current->size(); ++i) {
+      RetainPtr<const CPDF_Object> item = current->GetObjectAt(i);
+      const CPDF_Reference* ref = item ? item->AsReference() : nullptr;
+      if (ref && ref->GetRefObjNum() == state->objnum) {
+        return -1;  // already on the page
+      }
+    }
+  }
+  // Record what this modifies: the page, its /Annots array, the annotation.
+  std::set<uint32_t> holders;
+  if (page_dict && page_dict->GetObjNum()) {
+    holders.insert(page_dict->GetObjNum());
+  }
+  if (const CPDF_Reference* annots_ref =
+          page_dict ? ToReference(page_dict->GetObjectFor("Annots").Get())
+                    : nullptr) {
+    holders.insert(annots_ref->GetRefObjNum());
+  }
+  if (target) {
+    holders.insert(state->objnum);
+  }
+  CPDFSDK_ModifiedObjectsTracker tracker(doc, holders);
+  RetainPtr<CPDF_Array> annots = pPage->GetOrCreateAnnotsArray();
+  if (!annots) {
+    return -1;
+  }
+  const size_t at = index < 0 ? annots->size()
+                              : std::min(static_cast<size_t>(index), annots->size());
+  if (target) {
+    ReplaceDictContents(target.Get(), state->dict.Get());
+    annots->InsertNewAt<CPDF_Reference>(at, doc, state->objnum);
+  } else if (!state->objnum && state->source) {
+    // A direct annotation: its own dictionary object, unless it is still
+    // listed somewhere on this page.
+    RetainPtr<const CPDF_Array> listed = pPage->GetAnnotsArray();
+    for (size_t i = 0; listed && i < listed->size(); ++i) {
+      if (listed->GetObjectAt(i).Get() == state->source.Get()) {
+        return -1;
+      }
+    }
+    ReplaceDictContents(state->source.Get(), state->dict.Get());
+    annots->InsertAt(at, state->source);
+  } else {
+    RetainPtr<CPDF_Dictionary> copy = ToDictionary(state->dict->Clone());
+    if (!copy) {
+      return -1;
+    }
+    state->source = copy;  // a later RestoreState applies to this copy
+    annots->InsertAt(at, std::move(copy));
+  }
+  state->inserted = true;
+  return pdfium::checked_cast<int>(at);
+}
+
+FPDF_EXPORT void FPDF_CALLCONV FPDFAnnot_ReleaseState(FPDF_DOCUMENT document,
+                                                     int id) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  if (doc) {
+    doc->ReleaseAnnotState(id);
+  }
+}
