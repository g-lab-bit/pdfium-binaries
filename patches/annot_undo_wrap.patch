+// ---------------------------------------------------------------------------
+// g-lab-bit fork (annot_undo_wrap.patch): wrap another tool's appearance.
+// ---------------------------------------------------------------------------
+namespace {
+
+constexpr char kWrapOriginalKey[] = "RpOriginal";
+
+RetainPtr<CPDF_Dictionary> NewTransparencyGroup(CPDF_Document* doc) {
+  auto group = doc->New<CPDF_Dictionary>();
+  group->SetNewFor<CPDF_Name>("S", "Transparency");
+  group->SetNewFor<CPDF_Name>("CS", "DeviceRGB");
+  group->SetNewFor<CPDF_Boolean>("I", true);
+  return group;
+}
+
+RetainPtr<CPDF_Stream> NewForm(CPDF_Document* doc,
+                               const CFX_FloatRect& bbox,
+                               RetainPtr<CPDF_Dictionary> resources,
+                               bool group,
+                               const ByteString& content) {
+  auto dict = doc->New<CPDF_Dictionary>();
+  dict->SetNewFor<CPDF_Name>("Type", "XObject");
+  dict->SetNewFor<CPDF_Name>("Subtype", "Form");
+  dict->SetRectFor("BBox", bbox);
+  dict->SetFor("Resources", std::move(resources));
+  if (group) {
+    dict->SetFor("Group", NewTransparencyGroup(doc));
+  }
+  auto stream = doc->NewIndirect<CPDF_Stream>(std::move(dict));
+  stream->SetData(content.unsigned_span());
+  return stream;
+}
+
+}  // namespace
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_WrapAppearance(FPDF_DOCUMENT document,
+                         FPDF_ANNOTATION annot,
+                         const float* tint_rgb,
+                         const int* ocg_indices,
+                         int ocg_count) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  CPDF_AnnotContext* context = CPDFAnnotContextFromFPDFAnnotation(annot);
+  if (doc) {
+    doc->SetLastModifiedObjects({});  // ocg_objnums.patch
+  }
+  if (!AnnotInDoc(doc, context) || ocg_count < 0 ||
+      (ocg_count > 0 && !ocg_indices)) {
+    return false;
+  }
+  RetainPtr<CPDF_Dictionary> annot_dict = context->GetMutableAnnotDict();
+  RetainPtr<const CPDF_Dictionary> ap =
+      annot_dict ? annot_dict->GetDictFor("AP") : nullptr;
+  const CPDF_Reference* n_ref =
+      ap ? ToReference(ap->GetObjectFor("N").Get()) : nullptr;
+  RetainPtr<CPDF_Stream> current =
+      n_ref ? ToStream(doc->GetOrParseIndirectObject(n_ref->GetRefObjNum()))
+            : nullptr;
+  if (!current) {
+    return false;  // no normal appearance stream (or appearance states)
+  }
+  // Always wrap the ORIGINAL appearance, never a previous wrapper.
+  uint32_t original_objnum = n_ref->GetRefObjNum();
+  {
+    const CPDF_Reference* orig_ref = ToReference(
+        current->GetDict()->GetObjectFor(kWrapOriginalKey).Get());
+    if (orig_ref &&
+        ToStream(doc->GetOrParseIndirectObject(orig_ref->GetRefObjNum()))) {
+      original_objnum = orig_ref->GetRefObjNum();
+    }
+  }
+  RetainPtr<CPDF_Stream> original =
+      ToStream(doc->GetOrParseIndirectObject(original_objnum));
+
+  // Validate the layer indices before changing anything.
+  std::vector<uint32_t> ocg_objnums;
+  if (ocg_count > 0) {
+    const CPDF_Dictionary* root = doc->GetRoot();
+    RetainPtr<const CPDF_Dictionary> oc_properties =
+        root ? root->GetDictFor("OCProperties") : nullptr;
+    RetainPtr<const CPDF_Array> ocgs =
+        oc_properties ? oc_properties->GetArrayFor("OCGs") : nullptr;
+    // SAFETY: required from caller.
+    auto indices = UNSAFE_BUFFERS(
+        pdfium::span(ocg_indices, static_cast<size_t>(ocg_count)));
+    for (int index : indices) {
+      RetainPtr<const CPDF_Dictionary> ocg =
+          ocgs && index >= 0 && static_cast<size_t>(index) < ocgs->size()
+              ? ocgs->GetDictAt(index)
+              : nullptr;
+      if (!ocg || ocg->GetObjNum() == 0) {
+        return false;
+      }
+      if (!pdfium::Contains(ocg_objnums, ocg->GetObjNum())) {
+        ocg_objnums.push_back(ocg->GetObjNum());
+      }
+    }
+  }
+  if (tint_rgb) {
+    // SAFETY: required from caller (3 floats).
+    auto rgb = UNSAFE_BUFFERS(pdfium::span(tint_rgb, 3u));
+    for (float c : rgb) {
+      if (!std::isfinite(c) || c < 0.0f || c > 1.0f) {
+        return false;
+      }
+    }
+  }
+
+  if (!tint_rgb && ocg_objnums.empty() &&
+      original_objnum == n_ref->GetRefObjNum()) {
+    return true;  // nothing wrapped, nothing to undo: no change at all
+  }
+  CPDFSDK_ModifiedObjectsTracker tracker(doc,
+                                         CPDFSDK_AnnotHolderObjects(context));
+  // /AP as a direct dictionary of the annotation (an indirect one is copied,
+  // so no object other than the annotation's holders changes).
+  RetainPtr<CPDF_Dictionary> ap_dict = annot_dict->GetMutableDictFor("AP");
+  if (!ap_dict || ap_dict->GetObjNum() != 0) {
+    ap_dict = ToDictionary(ap->Clone());
+    annot_dict->SetFor("AP", ap_dict);
+  }
+
+  if (!tint_rgb && ocg_objnums.empty()) {
+    if (original_objnum != n_ref->GetRefObjNum()) {
+      ap_dict->SetNewFor<CPDF_Reference>("N", doc, original_objnum);  // unwrap
+    }
+    return true;
+  }
+
+  // Every form spans the original's box in the annotation's form space.
+  RetainPtr<const CPDF_Dictionary> original_dict = original->GetDict();
+  const CFX_FloatRect bbox = original_dict->GetMatrixFor("Matrix").TransformRect(
+      original_dict->GetRectFor("BBox"));
+  // Numbers through WriteFloat: locale-independent (never "0,3").
+  auto numbers = [](std::initializer_list<float> values) {
+    fxcrt::ostringstream buf;
+    for (float v : values) {
+      WriteFloat(buf, v) << " ";
+    }
+    return ByteString(buf);
+  };
+  const ByteString box =
+      numbers({bbox.left, bbox.bottom, bbox.Width(), bbox.Height()}) + "re f";
+
+  auto resources = doc->New<CPDF_Dictionary>();
+  auto xobjects = resources->SetNewFor<CPDF_Dictionary>("XObject");
+  xobjects->SetNewFor<CPDF_Reference>("O", doc, original_objnum);
+  ByteString body = "q /O Do Q\n";
+  if (tint_rgb) {
+    // The tint: the user's colour, clipped by the original's alpha (soft
+    // mask), blended /Color so the original's lightness shows through. The
+    // soft mask and the blend mode live in separate graphics states (pdf.js
+    // drops one when both are in the same one).
+    auto mask_resources = doc->New<CPDF_Dictionary>();
+    mask_resources->SetNewFor<CPDF_Dictionary>("XObject")
+        ->SetNewFor<CPDF_Reference>("O", doc, original_objnum);
+    RetainPtr<CPDF_Stream> mask_group =
+        NewForm(doc, bbox, mask_resources, true, "/O Do\n");
+    auto mask_gs = doc->NewIndirect<CPDF_Dictionary>();
+    mask_gs->SetNewFor<CPDF_Name>("Type", "ExtGState");
+    auto smask = mask_gs->SetNewFor<CPDF_Dictionary>("SMask");
+    smask->SetNewFor<CPDF_Name>("Type", "Mask");
+    smask->SetNewFor<CPDF_Name>("S", "Alpha");
+    smask->SetNewFor<CPDF_Reference>("G", doc, mask_group->GetObjNum());
+    auto tint_resources = doc->New<CPDF_Dictionary>();
+    tint_resources->SetNewFor<CPDF_Dictionary>("ExtGState")
+        ->SetNewFor<CPDF_Reference>("M", doc, mask_gs->GetObjNum());
+    // SAFETY: required from caller (3 floats).
+    auto rgb = UNSAFE_BUFFERS(pdfium::span(tint_rgb, 3u));
+    RetainPtr<CPDF_Stream> tint = NewForm(
+        doc, bbox, tint_resources, true,
+        "q /M gs " + numbers({rgb[0], rgb[1], rgb[2]}) + "rg " + box + " Q\n");
+    auto blend_gs = doc->NewIndirect<CPDF_Dictionary>();
+    blend_gs->SetNewFor<CPDF_Name>("Type", "ExtGState");
+    blend_gs->SetNewFor<CPDF_Name>("BM", "Color");
+    xobjects->SetNewFor<CPDF_Reference>("Tn", doc, tint->GetObjNum());
+    resources->SetNewFor<CPDF_Dictionary>("ExtGState")
+        ->SetNewFor<CPDF_Reference>("B", doc, blend_gs->GetObjNum());
+    body += "q /B gs /Tn Do Q\n";
+  }
+  // Layer marks around everything, outermost first.
+  ByteString content;
+  if (!ocg_objnums.empty()) {
+    auto properties = resources->SetNewFor<CPDF_Dictionary>("Properties");
+    for (size_t i = 0; i < ocg_objnums.size(); ++i) {
+      const ByteString name = ByteString::Format("RpOC%zu", i + 1);
+      properties->SetNewFor<CPDF_Reference>(name, doc, ocg_objnums[i]);
+      content += "/OC /" + name + " BDC\n";
+    }
+  }
+  content += body;
+  for (size_t i = 0; i < ocg_objnums.size(); ++i) {
+    content += "EMC\n";
+  }
+  // The wrapper is NOT a transparency group: the original (e.g. a Multiply
+  // highlight) and the /Color tint blend with the page as before.
+  RetainPtr<CPDF_Stream> wrapper = NewForm(doc, bbox, resources, false, content);
+  wrapper->GetMutableDict()->SetNewFor<CPDF_Reference>(kWrapOriginalKey, doc,
+                                                       original_objnum);
+  ap_dict->SetNewFor<CPDF_Reference>("N", doc, wrapper->GetObjNum());
+  return true;
+}
