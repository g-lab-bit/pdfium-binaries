+// ---------------------------------------------------------------------------
+// g-lab-bit fork (annot_undo_wrap.patch): exact undo of annotation edits.
+// ---------------------------------------------------------------------------
+namespace {
+
+// Replace every entry of |target| with a copy of |source|'s entries.
+void ReplaceDictContents(CPDF_Dictionary* target, const CPDF_Dictionary* source) {
+  for (const ByteString& key : target->GetKeys()) {
+    target->RemoveFor(key.AsStringView());
+  }
+  CPDF_DictionaryLocker locker(source);
+  for (const auto& [key, value] : locker) {
+    target->SetFor(key, value->Clone());
+  }
+}
+
+bool AnnotInDoc(CPDF_Document* doc, CPDF_AnnotContext* context) {
+  return doc && context && context->GetPage() &&
+         context->GetPage()->GetDocument() == doc;
+}
+
+}  // namespace
+
+FPDF_EXPORT int FPDF_CALLCONV FPDFAnnot_SaveState(FPDF_DOCUMENT document,
+                                                 FPDF_ANNOTATION annot) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  CPDF_AnnotContext* context = CPDFAnnotContextFromFPDFAnnotation(annot);
+  if (!AnnotInDoc(doc, context) || !context->GetAnnotDict()) {
+    return 0;
+  }
+  const CPDF_Dictionary* dict = context->GetAnnotDict();
+  RetainPtr<CPDF_Dictionary> copy = ToDictionary(dict->Clone());
+  if (!copy) {
+    return 0;
+  }
+  return doc->AddAnnotState({std::move(copy), dict->GetObjNum()});
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_RestoreState(FPDF_DOCUMENT document, FPDF_ANNOTATION annot, int id) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  CPDF_AnnotContext* context = CPDFAnnotContextFromFPDFAnnotation(annot);
+  if (doc) {
+    doc->SetLastModifiedObjects({});  // ocg_objnums.patch
+  }
+  if (!AnnotInDoc(doc, context)) {
+    return false;
+  }
+  const CPDF_Document::AnnotState* state = doc->GetAnnotState(id);
+  RetainPtr<CPDF_Dictionary> dict = context->GetMutableAnnotDict();
+  if (!state || !dict || state->objnum != dict->GetObjNum()) {
+    return false;
+  }
+  CPDFSDK_ModifiedObjectsTracker tracker(doc,
+                                         CPDFSDK_AnnotHolderObjects(context));
+  ReplaceDictContents(dict.Get(), state->dict.Get());
+  return true;
+}
+
+FPDF_EXPORT int FPDF_CALLCONV FPDFPage_InsertAnnotState(FPDF_DOCUMENT document,
+                                                       FPDF_PAGE page,
+                                                       int id,
+                                                       int index) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  CPDF_Page* pPage = CPDFPageFromFPDFPage(page);
+  if (doc) {
+    doc->SetLastModifiedObjects({});  // ocg_objnums.patch
+  }
+  if (!doc || !pPage || pPage->GetDocument() != doc) {
+    return -1;
+  }
+  const CPDF_Document::AnnotState* state = doc->GetAnnotState(id);
+  if (!state) {
+    return -1;
+  }
+  // The same indirect object, if it still exists and this page does not
+  // already list it; otherwise a direct copy.
+  RetainPtr<CPDF_Dictionary> target;
+  if (state->objnum) {
+    target = ToDictionary(doc->GetOrParseIndirectObject(state->objnum));
+    RetainPtr<const CPDF_Array> current = pPage->GetAnnotsArray();
+    for (size_t i = 0; target && current && i < current->size(); ++i) {
+      RetainPtr<const CPDF_Object> item = current->GetObjectAt(i);
+      const CPDF_Reference* ref = item ? item->AsReference() : nullptr;
+      if (ref && ref->GetRefObjNum() == state->objnum) {
+        return -1;  // already on the page
+      }
+    }
+  }
+  RetainPtr<CPDF_Array> annots = pPage->GetOrCreateAnnotsArray();
+  if (!annots) {
+    return -1;
+  }
+  const size_t at = index < 0 ? annots->size()
+                              : std::min(static_cast<size_t>(index), annots->size());
+  if (target) {
+    ReplaceDictContents(target.Get(), state->dict.Get());
+    annots->InsertNewAt<CPDF_Reference>(at, doc, state->objnum);
+  } else {
+    RetainPtr<CPDF_Dictionary> copy = ToDictionary(state->dict->Clone());
+    if (!copy) {
+      return -1;
+    }
+    annots->InsertAt(at, std::move(copy));
+  }
+  return pdfium::checked_cast<int>(at);
+}
+
+FPDF_EXPORT void FPDF_CALLCONV FPDFAnnot_ReleaseState(FPDF_DOCUMENT document,
+                                                     int id) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  if (doc) {
+    doc->ReleaseAnnotState(id);
+  }
+}
