+// g-lab-bit fork (annot_undo_wrap.patch)
+// Experimental API.
+// Exact undo of annotation edits. Saves a deep copy of |annot|'s dictionary
+// (references inside it stay references), held by |document| only (never
+// written to the file). Returns a state id > 0, or 0 on failure.
+FPDF_EXPORT int FPDF_CALLCONV FPDFAnnot_SaveState(FPDF_DOCUMENT document,
+                                                 FPDF_ANNOTATION annot);
+
+// g-lab-bit fork (annot_undo_wrap.patch)
+// Experimental API.
+// Puts |annot|'s dictionary back to state |id|: every entry is replaced by a
+// copy of the saved one (the same object; an indirect annotation keeps its
+// object number). A restored dictionary equals the saved one value for value,
+// so FPDF_FilterUnchangedObjects treats an undone edit as no change. The state
+// stays saved. Returns false for an unknown id or a different annotation.
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_RestoreState(FPDF_DOCUMENT document, FPDF_ANNOTATION annot, int id);
