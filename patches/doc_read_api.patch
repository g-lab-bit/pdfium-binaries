+// generate content on it. Close with FPDF_ClosePage().
+//
+//   document   -   Handle to document.
+//   page_index -   Index number of the page. 0 for the first page.
+//
+// Returns a handle to the page, or NULL on failure (including XFA documents).
+FPDF_EXPORT FPDF_PAGE FPDF_CALLCONV
+FPDFDoc_LoadPageWithoutContent(FPDF_DOCUMENT document, int page_index);
+
+// Experimental API.
+// Optional content groups listed in the catalog's /OCProperties /OCGs array,
