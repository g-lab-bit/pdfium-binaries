+// g-lab-bit fork (ocg_view_state.patch).
+void CPDF_Document::SetOCGViewOverride(uint32_t ocg_objnum,
+                                       std::optional<bool> visible) {
+  if (visible.has_value()) {
+    ocg_view_overrides_[ocg_objnum] = visible.value();
+  } else {
+    ocg_view_overrides_.erase(ocg_objnum);
+  }
+}
+
+// g-lab-bit fork (ocg_view_state.patch).
+std::optional<bool> CPDF_Document::GetOCGViewOverride(
+    uint32_t ocg_objnum) const {
+  auto it = ocg_view_overrides_.find(ocg_objnum);
+  if (it == ocg_view_overrides_.end()) {
+    return std::nullopt;
+  }
+  return it->second;
+}
