+// g-lab-bit fork (ocg_view_state.patch).
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFDoc_SetOCGViewState(FPDF_DOCUMENT document, int index, int state) {
+  auto* doc = CPDFDocumentFromFPDFDocument(document);
+  RetainPtr<const CPDF_Dictionary> ocg = GetOCGDict(document, index);
+  if (!doc || !ocg || ocg->GetObjNum() == 0 || state < -1 || state > 1) {
+    return false;
+  }
+  std::optional<bool> visible;
+  if (state != -1) {
+    visible = state == 1;
+  }
+  doc->SetOCGViewOverride(ocg->GetObjNum(), visible);
+  return true;
+}
+
+// g-lab-bit fork (ocg_view_state.patch).
+FPDF_EXPORT int FPDF_CALLCONV FPDFDoc_GetOCGViewState(FPDF_DOCUMENT document,
+                                                     int index) {
+  auto* doc = CPDFDocumentFromFPDFDocument(document);
+  RetainPtr<const CPDF_Dictionary> ocg = GetOCGDict(document, index);
+  if (!doc || !ocg || ocg->GetObjNum() == 0) {
+    return -2;
+  }
+  std::optional<bool> state = doc->GetOCGViewOverride(ocg->GetObjNum());
+  return state.has_value() ? (state.value() ? 1 : 0) : -1;
+}
+
+// g-lab-bit fork (ocg_view_state.patch).
+FPDF_EXPORT void FPDF_CALLCONV
+FPDFDoc_ClearOCGViewState(FPDF_DOCUMENT document) {
+  auto* doc = CPDFDocumentFromFPDFDocument(document);
+  if (doc) {
+    doc->ClearOCGViewOverrides();
+  }
+}
