+// g-lab-bit fork (incremental_objects.patch).
+//
+// The update layout (which objects go in, xref table vs. xref stream chosen
+// from the original's last section, the stream listing itself with /Type/XRef
+// and a sized /W, trailer = /Root /Info /Encrypt /ID /Size /Prev) is ported
+// from pdf.js src/core/writer.js (incrementalUpdate, getXRefTable,
+// getXRefStreamTable, getTrailerDict, computeIDs), Copyright 2020 Mozilla
+// Foundation, Apache License 2.0. The damaged-original fallback (full table,
+// no /Prev) mirrors PDFium's own FPDF_INCREMENTAL path above.
+bool CPDF_Creator::CreateIncrementalObjects(
+    pdfium::span<const uint32_t> objnums) {
+  if (!parser_) {
+    return false;  // New document: nothing to append to.
+  }
+  const CPDF_CrossRefTable* xref_table = parser_->GetCrossRefTable();
+  RetainPtr<const CPDF_Dictionary> trailer = parser_->GetCombinedTrailer();
+  if (!xref_table || !trailer || !trailer->GetObjectFor("Root")) {
+    return false;
+  }
+
+  const uint32_t parser_last_obj_num = parser_->GetLastObjNum();
+  // Rebuilt xref: the original chain cannot be referenced with /Prev.
+  const bool damaged =
+      parser_->xref_table_rebuilt() || parser_->GetLastXRefOffset() <= 0;
+  const uint32_t encrypt_obj_num = encrypt_dict_ ? encrypt_dict_->GetObjNum() : 0;
+
+  // 1. The object set: listed objects (latest in-memory version) plus every
+  //    object created after load (numbered above the parser's last number).
+  std::map<uint32_t, RetainPtr<const CPDF_Object>> objects;
+  for (uint32_t objnum : objnums) {
+    // The /Encrypt dictionary is never rewritten.
+    if (objnum == 0 || objnum == CPDF_Object::kInvalidObjNum ||
+        objnum == encrypt_obj_num) {
+      return false;
+    }
+    RetainPtr<const CPDF_Object> obj =
+        document_->GetOrParseIndirectObject(objnum);
+    if (!obj) {
+      return false;
+    }
+    objects[objnum] = std::move(obj);
+  }
+  for (const auto& [objnum, obj] : *document_) {
+    if (objnum > parser_last_obj_num && obj && obj->GetObjNum() == objnum) {
+      objects[objnum] = obj;
+    }
+  }
+
+  // 2. Validate everything before the first byte is written.
+  //    WriteIndirectObj(), CPDF_Reference::WriteTo() and CPDF_Encryptor all
+  //    assume generation 0, so refuse any other generation.
+  auto has_nonzero_gen = [&](uint32_t objnum) {
+    const CPDF_CrossRefTable::ObjectInfo* info =
+        xref_table->GetObjectInfo(objnum);
+    if (info && info->type == CPDF_CrossRefTable::ObjectType::kNormal &&
+        info->gennum != 0) {
+      return true;
+    }
+    RetainPtr<const CPDF_Object> loaded = document_->GetIndirectObject(objnum);
+    return loaded && loaded->GetGenNum() != 0;
+  };
+  // CPDF_Stream::WriteTo() never encrypts XML metadata; refuse to write it
+  // in plain text into a file whose readers expect it encrypted.
+  const bool metadata_encrypted =
+      GetCryptoHandler() && security_handler_->IsMetadataEncrypted();
+  for (const auto& [objnum, obj] : objects) {
+    if (obj->GetGenNum() != 0 || has_nonzero_gen(objnum)) {
+      return false;
+    }
+    if (metadata_encrypted && IsXMLMetadataStream(obj.Get())) {
+      return false;
+    }
+    CPDF_ObjectWalker walker(obj);
+    while (RetainPtr<const CPDF_Object> sub = walker.GetNext()) {
+      const CPDF_Reference* ref = sub->AsReference();
+      if (ref && has_nonzero_gen(ref->GetRefObjNum())) {
+        return false;
+      }
+    }
+  }
+  for (const char* key : {"Root", "Info", "Encrypt"}) {
+    const CPDF_Reference* ref = ToReference(trailer->GetObjectFor(key).Get());
+    if (ref && has_nonzero_gen(ref->GetRefObjNum())) {
+      return false;
+    }
+  }
+  if (damaged) {
+    // A full table cannot express compressed (object stream) entries; the
+    // stock path would write offset 0 for them.
+    for (const auto& [num, info] : xref_table->objects_info()) {
+      if (info.type == CPDF_CrossRefTable::ObjectType::kCompressed) {
+        return false;
+      }
+    }
+  }
+
+  // /ID: keep the original first element (it keys RC4/AESV2 encryption).
+  // Encrypted: keep the second too, like FPDF_INCREMENTAL. An encrypted file
+  // without /ID keeps having none (adding one would change its file key).
+  RetainPtr<CPDF_Array> id_array;
+  auto append_random_id = [](CPDF_Array* array) {
+    std::array<uint32_t, 4> file_id;
+    FX_Random::Fill(file_id);
+    array->AppendNew<CPDF_String>(pdfium::as_byte_span(file_id),
+                                  CPDF_String::DataType::kIsHex);
+  };
+  RetainPtr<const CPDF_Array> old_ids = parser_->GetIDArray();
+  RetainPtr<const CPDF_Object> old_id0 =
+      old_ids ? old_ids->GetDirectObjectAt(0) : nullptr;
+  if (old_id0 && old_id0->IsString()) {
+    id_array = document_->New<CPDF_Array>();
+    id_array->Append(old_id0->Clone());
+    RetainPtr<const CPDF_Object> old_id1 = old_ids->GetDirectObjectAt(1);
+    if (encrypt_dict_ && old_id1 && old_id1->IsString()) {
+      id_array->Append(old_id1->Clone());
+    } else {
+      append_random_id(id_array.Get());
+    }
+  } else if (!encrypt_dict_) {
+    id_array = document_->New<CPDF_Array>();
+    append_random_id(id_array.Get());
+    id_array->Append(id_array->GetObjectAt(0)->Clone());
+  }
+
+  uint32_t size = parser_last_obj_num + 1;
+  if (!objects.empty()) {
+    size = std::max(size, objects.rbegin()->first + 1);
+  }
+  const int orig_size = trailer->GetIntegerFor("Size");
+  if (orig_size > 0) {
+    size = std::max(size, static_cast<uint32_t>(orig_size));
+  }
+
+  // 3. Original bytes, unchanged.
+  if (!parser_->WriteToArchive(archive_.get(), parser_->GetDocumentSize())) {
+    return false;
+  }
+  if (objects.empty()) {
+    return true;  // Documented: nothing to update, output == original.
+  }
+  // The original may not end with an EOL; never glue "N 0 obj" to "%%EOF".
+  if (!archive_->WriteString("\r\n")) {
+    return false;
+  }
+
+  // 4. Objects, ascending, encrypted per object by WriteIndirectObj().
+  std::map<uint32_t, FX_FILESIZE> offsets;
+  for (const auto& [objnum, obj] : objects) {
+    offsets[objnum] = archive_->CurrentOffset();
+    if (!WriteIndirectObj(objnum, obj.Get())) {
+      return false;
+    }
+  }
+
+  // 5. Cross-reference section + trailer.
+  xref_start_ = archive_->CurrentOffset();
+  if (damaged || !parser_->IsXRefStream()) {
+    std::map<uint32_t, IncrementalXRefEntry> entries;
+    if (damaged) {
+      entries[0] = {0, 65535, false};
+      for (const auto& [num, info] : xref_table->objects_info()) {
+        if (num != 0 && info.type == CPDF_CrossRefTable::ObjectType::kNormal) {
+          entries[num] = {info.pos, info.gennum, true};
+        }
+      }
+    }
+    for (const auto& [num, pos] : offsets) {
+      entries[num] = {pos, 0, true};
+    }
+    return archive_->WriteString("xref\r\n") &&
+           WriteClassicXRefEntries(archive_.get(), entries) &&
+           archive_->WriteString("trailer\r\n<<") &&
+           WriteIncrementalTrailerEntries(trailer.Get(), id_array.Get(), size,
+                                          /*write_prev=*/!damaged) &&
+           archive_->WriteString(">>\r\nstartxref\r\n") &&
+           archive_->WriteFilesize(xref_start_) &&
+           archive_->WriteString("\r\n%%EOF\r\n");
+  }
+
+  // Cross-reference stream that lists itself.
+  const uint32_t xref_obj_num =
+      std::max(size, document_->GetLastObjNum() + 1);
+  offsets[xref_obj_num] = xref_start_;
+  size = xref_obj_num + 1;
+  int offset_width = 1;
+  while (offset_width < 8 &&
+         (static_cast<uint64_t>(xref_start_) >> (8 * offset_width)) != 0) {
+    ++offset_width;
+  }
+  ByteString index;
+  DataVector<uint8_t> data;
+  for (auto it = offsets.begin(); it != offsets.end();) {
+    auto run_end = it;
+    uint32_t count = 0;
+    while (run_end != offsets.end() && run_end->first == it->first + count) {
+      ++run_end;
+      ++count;
+    }
+    index += ByteString::Format("%u %u ", it->first, count);
+    for (; it != run_end; ++it) {
+      const uint64_t pos = static_cast<uint64_t>(it->second);
+      data.push_back(1);
+      for (int shift = 8 * (offset_width - 1); shift >= 0; shift -= 8) {
+        data.push_back(static_cast<uint8_t>(pos >> shift));
+      }
+      data.push_back(0);
+    }
+  }
+  return archive_->WriteDWord(xref_obj_num) &&
+         archive_->WriteString(" 0 obj\r\n<</Type/XRef") &&
+         WriteIncrementalTrailerEntries(trailer.Get(), id_array.Get(), size,
+                                        /*write_prev=*/true) &&
+         archive_->WriteString(
+             ByteString::Format("/W[1 %d 1]/Index[", offset_width)
+                 .AsStringView()) &&
+         archive_->WriteString(index.AsStringView()) &&
+         archive_->WriteString("]/Length ") &&
+         archive_->WriteDWord(static_cast<uint32_t>(data.size())) &&
+         archive_->WriteString(">>stream\r\n") &&
+         archive_->WriteBlock(data) &&
+         archive_->WriteString("\r\nendstream\r\nendobj\r\nstartxref\r\n") &&
+         archive_->WriteFilesize(xref_start_) &&
+         archive_->WriteString("\r\n%%EOF\r\n");
+}
+
+bool CPDF_Creator::WriteIncrementalTrailerEntries(
+    const CPDF_Dictionary* trailer,
+    const CPDF_Array* id_array,
+    uint32_t size,
+    bool write_prev) {
+  for (const char* key : {"Root", "Info", "Encrypt"}) {
+    RetainPtr<const CPDF_Object> value = trailer->GetObjectFor(key);
+    if (!value) {
+      continue;
+    }
+    // Same references as the original; /Encrypt is never re-encrypted.
+    if (!archive_->WriteString("/") || !archive_->WriteString(key) ||
+        !value->WriteTo(archive_.get(), nullptr)) {
+      return false;
+    }
+  }
+  if (id_array && (!archive_->WriteString("/ID") ||
+                   !id_array->WriteTo(archive_.get(), nullptr))) {
+    return false;
+  }
+  if (!archive_->WriteString("/Size ") || !archive_->WriteDWord(size)) {
+    return false;
+  }
+  return !write_prev ||
+         (archive_->WriteString("/Prev ") &&
+          archive_->WriteFilesize(parser_->GetLastXRefOffset()));
+}
+
