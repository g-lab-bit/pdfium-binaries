+// Receives the original file (CPDF_Parser::WriteWholeFileToArchive) and
+// compares it with the start of the saved file.
+class PrefixCompareArchive final : public IFX_ArchiveStream {
+ public:
+  explicit PrefixCompareArchive(RetainPtr<IFX_SeekableReadStream> saved)
+      : saved_(std::move(saved)) {}
+
+  bool WriteBlock(pdfium::span<const uint8_t> buffer) override {
+    buffer_.resize(buffer.size());
+    if (!saved_->ReadBlockAtOffset(buffer_, offset_) ||
+        !std::ranges::equal(buffer_, buffer)) {
+      return false;
+    }
+    offset_ += buffer.size();
+    return true;
+  }
+  FX_FILESIZE CurrentOffset() const override { return offset_; }
+
+ private:
+  RetainPtr<IFX_SeekableReadStream> const saved_;
+  DataVector<uint8_t> buffer_;
+  FX_FILESIZE offset_ = 0;
+};
