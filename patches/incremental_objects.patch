+// Walks a dictionary at the parser's position ("<<" next) key by key,
+// skipping values with GetObjectBody() so strings cannot fake a key; keys
+// are name-decoded before comparison. Returns
+// the raw /Prev token as a 64-bit value (CPDF_Number cannot hold offsets of
+// 4 GB or more) and fails on /XRefStm.
+bool ReadSectionDict(CPDF_SyntaxParser* syntax,
+                     std::optional<FX_FILESIZE>* prev) {
+  if (syntax->GetNextWord().word != "<<") {
+    return false;
+  }
+  for (int keys = 0; keys < 1024; ++keys) {
+    const CPDF_SyntaxParser::WordResult key = syntax->GetNextWord();
+    if (key.word == ">>") {
+      return true;
+    }
+    if (key.word.GetLength() < 2 || key.word[0] != '/') {
+      return false;
+    }
+    // Keys are compared decoded (e.g. /P#72ev is /Prev), as PDFium reads them.
+    const ByteString name = PDF_NameDecode(key.word.AsStringView().Substr(1));
+    if (name == "XRefStm") {
+      return false;
+    }
+    if (name == "Prev") {
+      const CPDF_SyntaxParser::WordResult value = syntax->GetNextWord();
+      if (!value.is_number || value.word.IsEmpty() ||
+          !FXSYS_IsDecimalDigit(value.word[0]) || value.word.GetLength() > 18) {
+        return false;
+      }
+      *prev = FXSYS_atoi64(value.word.c_str());
+      continue;
+    }
+    if (!syntax->GetObjectBody(nullptr)) {
+      return false;
+    }
+  }
+  return false;
+}
+
+// Reads the cross-reference sections located after the original file (the
+// update) by following the saved file's startxref/Prev chain with a plain
+// syntax parser (no decryption), and records every object number they
+// define (classic entries, free or in use; xref stream entries of any type)
+// and whether any section frees it. The chain must end exactly at the
+// original's last cross-reference section. Positions are relative to the
+// "%PDF-" header.
+bool CollectUpdateEntries(RetainPtr<IFX_SeekableReadStream> file,
+                          FX_FILESIZE header_offset,
+                          FX_FILESIZE original_size,
+                          FX_FILESIZE original_last_xref,
+                          FX_FILESIZE last_xref,
+                          std::map<uint32_t, bool>* defined,
+                          std::set<uint32_t>* xref_streams) {
+  CPDF_SyntaxParser syntax(
+      pdfium::MakeRetain<CPDF_ReadValidator>(std::move(file), nullptr),
+      header_offset);
+  // Sections are read newest first; an object freed by ANY update section
+  // stays recorded as freed.
+  auto record = [defined](uint64_t objnum, bool freed) {
+    if (objnum > CPDF_Parser::kMaxObjectNumber) {
+      return false;
+    }
+    auto [it, inserted] =
+        defined->emplace(static_cast<uint32_t>(objnum), freed);
+    if (!inserted) {
+      it->second = it->second || freed;
+    }
+    return true;
+  };
+  auto read_uint = [&syntax](uint64_t* value) {
+    const CPDF_SyntaxParser::WordResult w = syntax.GetNextWord();
+    if (!w.is_number || w.word.IsEmpty() || !FXSYS_IsDecimalDigit(w.word[0]) ||
+        w.word.GetLength() > 18) {
+      return false;
+    }
+    *value = static_cast<uint64_t>(FXSYS_atoi64(w.word.c_str()));
+    return true;
+  };
+
+  std::set<FX_FILESIZE> visited;
+  FX_FILESIZE pos = last_xref;
+  while (pos >= original_size) {
+    if (pos >= syntax.GetDocumentSize() || !visited.insert(pos).second ||
+        visited.size() > 1024) {
+      return false;
+    }
+    std::optional<FX_FILESIZE> prev;
+    syntax.SetPos(pos);
+    const CPDF_SyntaxParser::WordResult first = syntax.GetNextWord();
+    if (first.word == "xref") {
+      while (true) {
+        if (syntax.PeekNextWord() == "trailer") {
+          syntax.GetNextWord();
+          break;
+        }
+        uint64_t start = 0;
+        uint64_t count = 0;
+        if (!read_uint(&start) || !read_uint(&count) ||
+            start + count > uint64_t{CPDF_Parser::kMaxObjectNumber} + 1) {
+          return false;
+        }
+        for (uint64_t k = 0; k < count; ++k) {
+          uint64_t offset = 0;
+          uint64_t gen = 0;
+          if (!read_uint(&offset) || !read_uint(&gen)) {
+            return false;
+          }
+          const ByteString type = syntax.GetNextWord().word;
+          if ((type != "n" && type != "f") || !record(start + k, type == "f")) {
+            return false;
+          }
+        }
+      }
+      if (!ReadSectionDict(&syntax, &prev)) {
+        return false;
+      }
+    } else {
+      // An xref stream: "N G obj" exactly at `pos`, /Type /XRef. Parsed
+      // without decryption (xref streams are never encrypted).
+      uint64_t objnum = 0;
+      uint64_t gen = 0;
+      if (!first.is_number || first.word.IsEmpty() ||
+          !FXSYS_IsDecimalDigit(first.word[0]) || first.word.GetLength() > 10) {
+        return false;
+      }
+      objnum = static_cast<uint64_t>(FXSYS_atoi64(first.word.c_str()));
+      if (objnum == 0 || objnum > CPDF_Parser::kMaxObjectNumber ||
+          !read_uint(&gen) || gen != 0 || syntax.GetKeyword() != "obj" ||
+          !ReadSectionDict(&syntax, &prev)) {
+        return false;
+      }
+      syntax.SetPos(pos);
+      RetainPtr<CPDF_Object> obj = syntax.GetIndirectObject(
+          nullptr, CPDF_SyntaxParser::ParseType::kStrict);
+      const CPDF_Stream* stream = obj ? obj->AsStream() : nullptr;
+      RetainPtr<const CPDF_Dictionary> dict =
+          stream ? stream->GetDict() : nullptr;
+      if (!dict || obj->GetObjNum() != objnum || obj->GetGenNum() != 0 ||
+          dict->GetNameFor("Type") != "XRef") {
+        return false;
+      }
+      xref_streams->insert(static_cast<uint32_t>(objnum));
+      RetainPtr<const CPDF_Array> w = dict->GetArrayFor("W");
+      if (!w || w->size() != 3) {
+        return false;
+      }
+      std::array<uint32_t, 3> widths;
+      uint32_t row = 0;
+      for (size_t k = 0; k < 3; ++k) {
+        const int width = w->GetIntegerAt(k);
+        if (width < 0 || width > (k == 0 ? 4 : 8)) {
+          return false;
+        }
+        widths[k] = static_cast<uint32_t>(width);
+        row += widths[k];
+      }
+      if (row == 0) {
+        return false;
+      }
+      std::vector<std::pair<uint64_t, uint64_t>> sections;
+      RetainPtr<const CPDF_Array> index = dict->GetArrayFor("Index");
+      if (index) {
+        if (index->size() % 2 != 0) {
+          return false;
+        }
+        for (size_t k = 0; k < index->size(); k += 2) {
+          const int first_num = index->GetIntegerAt(k);
+          const int count = index->GetIntegerAt(k + 1);
+          if (first_num < 0 || count < 0) {
+            return false;
+          }
+          sections.emplace_back(first_num, count);
+        }
+      } else {
+        const int size = dict->GetIntegerFor("Size");
+        if (size < 0) {
+          return false;
+        }
+        sections.emplace_back(0, size);
+      }
+      auto acc = pdfium::MakeRetain<CPDF_StreamAcc>(pdfium::WrapRetain(stream));
+      acc->LoadAllDataFiltered();
+      pdfium::span<const uint8_t> data = acc->GetSpan();
+      size_t at = 0;
+      for (const auto& [first_num, count] : sections) {
+        for (uint64_t k = 0; k < count; ++k) {
+          if (at + row > data.size()) {
+            return false;
+          }
+          uint32_t type = widths[0] ? 0 : 1;
+          for (uint32_t b = 0; b < widths[0]; ++b) {
+            type = (type << 8) | data[at + b];
+          }
+          if (!record(first_num + k, type == 0)) {
+            return false;
+          }
+          at += row;
+        }
+      }
+      if (at != data.size()) {
+        return false;  // Trailing bytes after the last row.
+      }
+    }
+    if (!prev.has_value()) {
+      return false;  // An update must chain to the original.
+    }
+    pos = prev.value();
+  }
+  // Leaving the update, the chain must land exactly on the original's last
+  // cross-reference section.
+  return pos == original_last_xref;
+}
