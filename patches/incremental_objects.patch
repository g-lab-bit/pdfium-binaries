+bool IsXMLMetadataStream(const CPDF_Object* obj) {
+  const CPDF_Stream* stream = obj->AsStream();
+  if (!stream) {
+    return false;
+  }
+  RetainPtr<const CPDF_Dictionary> dict = stream->GetDict();
+  return dict && dict->GetNameFor("Type") == "Metadata" &&
+         dict->GetNameFor("Subtype") == "XML";
+}
+
+// Counts bytes without storing them: sizes the update before writing.
+class CountingArchive final : public IFX_ArchiveStream {
+ public:
+  bool WriteBlock(pdfium::span<const uint8_t> buffer) override {
+    FX_SAFE_FILESIZE safe_offset = offset_;
+    safe_offset += buffer.size();
+    if (!safe_offset.IsValid()) {
+      return false;
+    }
+    offset_ = safe_offset.ValueOrDie();
+    return true;
+  }
+  FX_FILESIZE CurrentOffset() const override { return offset_; }
+
+ private:
+  FX_FILESIZE offset_ = 0;
+};
+
+// Calls `fn(objnum)` for every reference inside `obj` (not following them).
+// Stops and returns false as soon as `fn` returns false.
+template <typename Fn>
+bool ForEachReference(RetainPtr<const CPDF_Object> obj, Fn fn) {
+  CPDF_ObjectWalker walker(std::move(obj));
+  while (RetainPtr<const CPDF_Object> sub = walker.GetNext()) {
+    const CPDF_Reference* ref = sub->AsReference();
+    if (ref && !fn(ref->GetRefObjNum())) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Like ForEachReference(), but for the bytes CPDF_Stream::WriteTo() will
+// produce: an unfiltered stream (other than XML metadata) is always
+// Flate-encoded into a cloned dictionary with a direct /Length, so its
+// original (possibly indirect) /Length is not written. A filtered stream keeps
+// its dictionary, indirect /Length included, when the length is unchanged.
+template <typename Fn>
+bool ForEachWrittenReference(RetainPtr<const CPDF_Object> obj, Fn fn) {
+  const CPDF_Stream* stream = obj->AsStream();
+  if (!stream || stream->HasFilter() || IsXMLMetadataStream(stream)) {
+    return ForEachReference(std::move(obj), fn);
+  }
+  CPDF_DictionaryLocker locker(stream->GetDict());
+  for (const auto& [key, value] : locker) {
+    if (key != "Length" && !ForEachReference(value, fn)) {
+      return false;
+    }
+  }
+  return true;
+}
