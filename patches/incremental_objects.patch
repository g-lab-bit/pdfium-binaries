+// g-lab-bit fork (incremental_objects.patch)
+// Experimental API.
+// Function: FPDF_SaveIncrementalObjects
+//          Writes the original file bytes, unchanged, followed by ONE
+//          incremental update that contains exactly:
+//            - the objects listed in |objnums|, in their current in-memory
+//              state (re-encrypted per object for encrypted documents), and
+//            - every object created since the document was loaded (object
+//              number above the original's last object number), so callers
+//              only need to track the EXISTING objects they changed.
+//          Nothing else is rewritten; in particular the /Encrypt dictionary
+//          is never written. The new cross-reference section has the type of
+//          the original's last section (xref stream -> xref stream with
+//          /Type /XRef, a self entry and /W sized for the offsets; table or
+//          hybrid -> classic table) and its trailer has /Prev, /Root, /Info,
+//          /Encrypt (same reference), /Size and /ID (original first element;
+//          second element kept for encrypted files, new otherwise).
+//          If PDFium had to rebuild the cross-reference table on load
+//          (damaged file), the update carries a full classic table and no
+//          /Prev, like FPDF_SaveAsCopy(FPDF_INCREMENTAL).
+//          The output is always "original + one update", also when called
+//          repeatedly on the same FPDF_DOCUMENT; to stack updates, load the
+//          saved file and save from that document.
+// Parameters:
+//          document   -   Handle to a document loaded from a file.
+//          file_write -   A pointer to a custom file write structure.
+//          objnums    -   Object numbers of the existing objects that
+//                         changed. Duplicates are allowed. May be NULL if
+//                         |count| is 0.
+//          count      -   Number of entries in |objnums|.
+// Return value:
+//          TRUE on success. If nothing needs writing (|count| is 0 and no
+//          object was created), the output is an exact copy of the original
+//          and TRUE is returned.
+//          FALSE (refusal) if |document| was not loaded from a file (no
+//          parser), a listed object does not exist, a listed object is the
+//          /Encrypt dictionary, a written object has a generation number
+//          other than 0 or references an object with one, an XML metadata
+//          stream would be written unencrypted into a file whose metadata is
+//          encrypted, or the cross-reference table was rebuilt and the
+//          original has objects in object streams. These checks run before
+//          any byte is written, so on refusal nothing has been written.
+//          FALSE is also returned when |file_write| fails; the partial
+//          output must then be discarded. On FALSE, fall back to a full save.
+// Notes:
+//          If the original has bytes before "%PDF-", those are not copied
+//          (PDFium positions are relative to the header).
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDF_SaveIncrementalObjects(FPDF_DOCUMENT document,
+                            FPDF_FILEWRITE* file_write,
+                            const uint32_t* objnums,
+                            size_t count);
+
+// g-lab-bit fork (incremental_objects.patch)
+// Experimental API.
+// Object-number accessors for building the |objnums| list above.
+//
+// FPDFPage_GetObjectNumber: object number of the page dictionary, or 0 if
+// it is not an indirect object (or on error).
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDFPage_GetObjectNumber(FPDF_PAGE page);
+
+// FPDFPage_GetAnnotsObjectNumber: object number of the page's /Annots array
+// if /Annots is an indirect reference, else 0 (direct array, absent, or
+// error). Adding or removing an annotation changes this array: list it when
+// non-zero, otherwise list the page dictionary.
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDFPage_GetAnnotsObjectNumber(FPDF_PAGE page);
+
+// FPDFAnnot_GetObjectNumber: object number of the annotation dictionary, or
+// 0 if it is a direct object inside /Annots (as FPDFPage_CreateAnnot makes
+// it), in which case its changes belong to the /Annots holder above.
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDFAnnot_GetObjectNumber(FPDF_ANNOTATION annot);
