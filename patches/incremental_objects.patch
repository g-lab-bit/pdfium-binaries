+class SaveVerifier {
+ public:
+  SaveVerifier(CPDF_Document* memory_doc, CPDF_Document* saved_doc)
+      : memory_doc_(memory_doc), saved_doc_(saved_doc) {
+    // Page tree and field tree dictionaries, found in memory without
+    // parsing (an unloaded node cannot have been changed).
+    const CPDF_Dictionary* root = memory_doc_->GetRoot();
+    if (!root) {
+      return;
+    }
+    CollectTree(MemoryDirect(root->GetObjectFor("Pages")), &page_tree_, 0);
+    RetainPtr<const CPDF_Object> acro_form =
+        MemoryDirect(root->GetObjectFor("AcroForm"));
+    const CPDF_Dictionary* form_dict =
+        acro_form ? acro_form->AsDictionary() : nullptr;
+    RetainPtr<const CPDF_Object> fields =
+        form_dict ? MemoryDirect(form_dict->GetObjectFor("Fields")) : nullptr;
+    const CPDF_Array* fields_array = fields ? fields->AsArray() : nullptr;
+    if (fields_array) {
+      for (size_t i = 0; i < fields_array->size(); ++i) {
+        CollectTree(MemoryDirect(fields_array->GetObjectAt(i)), &field_tree_,
+                    0);
+      }
+    }
+  }
+
+  bool ObjectsEqual(const CPDF_Object* mem,
+                    const CPDF_Object* saved,
+                    int depth) {
+    if (!mem || !saved || depth > kMaxCompareDepth ||
+        mem->GetType() != saved->GetType()) {
+      return false;
+    }
+    switch (mem->GetType()) {
+      case CPDF_Object::kBoolean:
+      case CPDF_Object::kNumber:  // Compared as PDFium serialises them.
+      case CPDF_Object::kString:  // Decoded bytes (M2).
+      case CPDF_Object::kName:    // Decoded name.
+        return mem->GetString() == saved->GetString();
+      case CPDF_Object::kNullobj:
+        return true;
+      case CPDF_Object::kReference:
+        return mem->AsReference()->GetRefObjNum() ==
+               saved->AsReference()->GetRefObjNum();
+      case CPDF_Object::kArray: {
+        const CPDF_Array* m = mem->AsArray();
+        const CPDF_Array* s = saved->AsArray();
+        if (m->size() != s->size()) {
+          return false;
+        }
+        for (size_t i = 0; i < m->size(); ++i) {
+          if (!ObjectsEqual(m->GetObjectAt(i).Get(), s->GetObjectAt(i).Get(),
+                            depth + 1)) {
+            return false;
+          }
+        }
+        return true;
+      }
+      case CPDF_Object::kDictionary:
+        return DictsEqual(mem->AsDictionary(), saved->AsDictionary(),
+                          /*stream_dict=*/false, /*flate_normalised=*/false,
+                          depth);
+      case CPDF_Object::kStream:
+        return StreamsEqual(mem->AsStream(), saved->AsStream(), depth);
+    }
+    return false;
+  }
+
+ private:
+  // Memory-side resolution without parsing (see the comment above).
+  RetainPtr<const CPDF_Object> MemoryDirect(RetainPtr<const CPDF_Object> obj) {
+    if (const CPDF_Reference* ref = ToReference(obj.Get())) {
+      return memory_doc_->GetIndirectObject(ref->GetRefObjNum());
+    }
+    return obj;
+  }
+
+  void CollectTree(RetainPtr<const CPDF_Object> node,
+                   std::set<const CPDF_Dictionary*>* tree,
+                   int depth) {
+    const CPDF_Dictionary* dict = node ? node->AsDictionary() : nullptr;
+    if (!dict || depth > kMaxTreeDepth || !tree->insert(dict).second) {
+      return;
+    }
+    RetainPtr<const CPDF_Object> kids =
+        MemoryDirect(dict->GetObjectFor("Kids"));
+    const CPDF_Array* kids_array = kids ? kids->AsArray() : nullptr;
+    if (!kids_array) {
+      return;
+    }
+    for (size_t i = 0; i < kids_array->size(); ++i) {
+      CollectTree(MemoryDirect(kids_array->GetObjectAt(i)), tree, depth + 1);
+    }
+  }
+
+  bool StreamsEqual(const CPDF_Stream* mem,
+                    const CPDF_Stream* saved,
+                    int depth) {
+    RetainPtr<const CPDF_Dictionary> mem_dict = mem->GetDict();
+    RetainPtr<const CPDF_Dictionary> saved_dict = saved->GetDict();
+    // M3: an unfiltered stream (not XML metadata) is written Flate-encoded.
+    bool flate_normalised = false;
+    if (!mem->HasFilter() && saved->HasFilter() &&
+        !IsXMLMetadata(mem_dict.Get())) {
+      RetainPtr<const CPDF_Object> filter =
+          saved_dict->GetDirectObjectFor("Filter");
+      const CPDF_Array* filter_array = filter ? filter->AsArray() : nullptr;
+      if (filter_array && filter_array->size() == 1) {
+        filter = filter_array->GetDirectObjectAt(0);
+      }
+      flate_normalised = filter && filter->IsName() &&
+                         filter->GetString() == "FlateDecode" &&
+                         !saved_dict->KeyExist("DecodeParms");
+    }
+    if (!DictsEqual(mem_dict.Get(), saved_dict.Get(), /*stream_dict=*/true,
+                    flate_normalised, depth)) {
+      return false;
+    }
+    auto mem_acc = pdfium::MakeRetain<CPDF_StreamAcc>(pdfium::WrapRetain(mem));
+    mem_acc->LoadAllDataRaw();
+    auto saved_acc =
+        pdfium::MakeRetain<CPDF_StreamAcc>(pdfium::WrapRetain(saved));
+    if (flate_normalised) {
+      saved_acc->LoadAllDataFiltered();
+    } else {
+      saved_acc->LoadAllDataRaw();
+    }
+    pdfium::span<const uint8_t> a = mem_acc->GetSpan();
+    pdfium::span<const uint8_t> b = saved_acc->GetSpan();
+    return a.size() == b.size() && std::ranges::equal(a, b);
+  }
+
+  bool DictsEqual(const CPDF_Dictionary* mem,
+                  const CPDF_Dictionary* saved,
+                  bool stream_dict,
+                  bool flate_normalised,
+                  int depth) {
+    auto skipped = [&](const ByteString& key) {
+      if (stream_dict && key == "Length") {
+        return true;  // M1
+      }
+      return flate_normalised && (key == "Filter" || key == "DecodeParms");
+    };
+    CPDF_DictionaryLocker mem_locker(mem);
+    for (const auto& [key, mem_value] : mem_locker) {
+      if (skipped(key)) {
+        continue;
+      }
+      RetainPtr<const CPDF_Object> saved_value =
+          saved->GetObjectFor(key.AsStringView());
+      if (saved_value &&
+          ObjectsEqual(mem_value.Get(), saved_value.Get(), depth + 1)) {
+        continue;
+      }
+      if (!IsToleratedDifference(mem, saved, key, mem_value.Get(),
+                                 saved_value.Get())) {
+        return false;
+      }
+    }
+    CPDF_DictionaryLocker saved_locker(saved);
+    for (const auto& [key, saved_value] : saved_locker) {
+      if (!skipped(key) && !mem->KeyExist(key.AsStringView())) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  // `saved_value` is null when the saved dictionary lacks `key`.
+  bool IsToleratedDifference(const CPDF_Dictionary* mem,
+                             const CPDF_Dictionary* saved,
+                             const ByteString& key,
+                             const CPDF_Object* mem_value,
+                             const CPDF_Object* saved_value) {
+    if (pdfium::Contains(page_tree_, mem)) {
+      if (key == "Type") {  // M4
+        const ByteString fixed = mem->KeyExist("Kids") ? "Pages" : "Page";
+        const bool saved_valid = saved_value && saved_value->IsName() &&
+                                 (saved_value->GetString() == "Page" ||
+                                  saved_value->GetString() == "Pages");
+        return mem_value->IsName() && mem_value->GetString() == fixed &&
+               !saved_valid;
+      }
+      if (key == "Count" && mem->KeyExist("Kids")) {  // M5
+        const int saved_count = saved_value && saved_value->IsNumber()
+                                    ? saved_value->GetInteger()
+                                    : 0;
+        return mem_value->IsNumber() &&
+               (saved_count <= 0 || saved_count >= CPDF_Document::kPageMaxNum);
+      }
+    }
+    if (!pdfium::Contains(field_tree_, mem)) {
+      return false;
+    }
+    if (key == "T" && mem_value->IsString() && saved_value &&
+        saved_value->IsReference()) {  // M7 (a)
+      RetainPtr<const CPDF_Object> target =
+          saved_doc_->GetOrParseIndirectObject(
+              saved_value->AsReference()->GetRefObjNum());
+      const ByteString expected =
+          target && target->IsString() ? target->GetString() : ByteString();
+      return mem_value->GetString() == expected;
+    }
+    if ((key == "FT" || key == "Ff") && !saved_value &&
+        !saved->KeyExist("FT") && mem->GetObjNum()) {  // M7 (b)
+      RetainPtr<const CPDF_Object> expected = CopiedFieldValue(mem, key);
+      return SameScalar(mem_value, expected.Get());
+    }
+    return false;
+  }
+
+  // The /FT or /Ff value AddTerminalField copies into `parent` (which had
+  // no /FT): from the first widget kid without /T whose /Parent is `parent`;
+  // /FT stops further copies, /Ff is copied as long as /FT is still absent.
+  RetainPtr<const CPDF_Object> CopiedFieldValue(const CPDF_Dictionary* parent,
+                                                const ByteString& key) {
+    RetainPtr<const CPDF_Object> kids =
+        MemoryDirect(parent->GetObjectFor("Kids"));
+    const CPDF_Array* kids_array = kids ? kids->AsArray() : nullptr;
+    RetainPtr<const CPDF_Object> result;
+    if (!kids_array) {
+      return result;
+    }
+    for (size_t i = 0; i < kids_array->size(); ++i) {
+      RetainPtr<const CPDF_Object> kid =
+          MemoryDirect(kids_array->GetObjectAt(i));
+      const CPDF_Dictionary* kid_dict = kid ? kid->AsDictionary() : nullptr;
+      const CPDF_Reference* kid_parent =
+          kid_dict ? ToReference(kid_dict->GetObjectFor("Parent").Get())
+                   : nullptr;
+      if (!kid_parent || kid_parent->GetRefObjNum() != parent->GetObjNum() ||
+          kid_dict->KeyExist("T") ||
+          kid_dict->GetNameFor("Subtype") != "Widget") {
+        continue;
+      }
+      RetainPtr<const CPDF_Object> value =
+          MemoryDirect(kid_dict->GetObjectFor(key.AsStringView()));
+      if (value) {
+        result = value;
+      }
+      if (kid_dict->KeyExist("FT")) {
+        break;  // The parent now has /FT: no further copies.
+      }
+    }
+    return result;
+  }
+
+  UnownedPtr<CPDF_Document> const memory_doc_;
+  UnownedPtr<CPDF_Document> const saved_doc_;
+  std::set<const CPDF_Dictionary*> page_tree_;
+  std::set<const CPDF_Dictionary*> field_tree_;
+};
+
+}  // namespace
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDF_VerifyIncrementalSave(FPDF_DOCUMENT document,
+                           FPDF_FILEACCESS* saved,
+                           uint32_t* first_mismatch_objnum) {
+  if (first_mismatch_objnum) {
+    *first_mismatch_objnum = 0;
+  }
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  if (!doc || !saved || !doc->GetParser()) {
+    return false;
+  }
+  CPDF_Parser* parser = doc->GetParser();
+  auto saved_file = pdfium::MakeRetain<CPDFSDK_CustomAccess>(saved);
+
+  // 1. The original file, as the parser read it (including any bytes before
+  //    "%PDF-"), must be an exact prefix of the saved file.
+  PrefixCompareArchive prefix(saved_file);
+  if (!parser->WriteWholeFileToArchive(&prefix)) {
+    return false;
+  }
+
+  // 2. The saved file, parsed as an independent document with the password
+  //    the original was opened with (the update keeps /Encrypt and ID[0], so
+  //    the file key is the same).
+  auto saved_doc =
+      std::make_unique<CPDF_Document>(std::make_unique<CPDF_DocRenderData>(),
+                                      std::make_unique<CPDF_DocPageData>());
+  if (saved_doc->LoadDoc(saved_file, parser->GetPassword()) !=
+      CPDF_Parser::SUCCESS) {
+    return false;
+  }
+  CPDF_Parser* saved_parser = saved_doc->GetParser();
+  if (saved_parser->xref_table_rebuilt() ||
+      saved_parser->GetLastXRefOffset() <= 0 ||
+      saved_parser->GetRootObjNum() != parser->GetRootObjNum()) {
+    return false;
+  }
+
+  // 3. The compared set: every loaded object from the original, plus the
+  //    new objects reachable from them (or from the trailer's /Root and
+  //    /Info) through new objects, as FPDF_SaveIncrementalObjects writes.
+  const uint32_t last_obj_num = parser->GetLastObjNum();
+  std::map<uint32_t, RetainPtr<const CPDF_Object>> objects;
+  std::vector<RetainPtr<const CPDF_Object>> pending;
+  for (const auto& [objnum, obj] : *doc) {
+    if (objnum <= last_obj_num && obj && obj->GetObjNum() == objnum) {
+      objects[objnum] = obj;
+      pending.push_back(obj);
+    }
+  }
+  auto add_new = [&](uint32_t objnum) {
+    if (objnum <= last_obj_num || pdfium::Contains(objects, objnum)) {
+      return;
+    }
+    RetainPtr<const CPDF_Object> obj = doc->GetIndirectObject(objnum);
+    if (obj && obj->GetObjNum() == objnum) {
+      objects[objnum] = obj;
+      pending.push_back(std::move(obj));
+    }
+  };
+  RetainPtr<const CPDF_Dictionary> trailer = parser->GetCombinedTrailer();
+  for (const char* key : {"Root", "Info"}) {
+    const CPDF_Reference* ref =
+        trailer ? ToReference(trailer->GetObjectFor(key).Get()) : nullptr;
+    if (ref) {
+      add_new(ref->GetRefObjNum());
+    }
+  }
+  while (!pending.empty()) {
+    RetainPtr<const CPDF_Object> obj = std::move(pending.back());
+    pending.pop_back();
+    ForEachRef(std::move(obj), add_new);
+  }
+
+  // 4. Nothing else changed: every object an update section defines must
+  //    be in the compared set (an object PDFium never held cannot
+  //    legitimately be in the update), and no update section may free an
+  //    object. The sections are read directly: PDFium's own parser ignores
+  //    free entries in classic tables (ParseCrossRefTable does not read
+  //    their generation, so MergeCrossRefObjectsData skips them), while
+  //    other readers delete those objects.
+  std::map<uint32_t, bool> defined;  // objnum -> freed by the update
+  std::set<uint32_t> update_xref_streams;
+  if (!CollectUpdateEntries(
+          saved_file, parser->GetHeaderOffsetInFile(),
+          parser->GetDocumentSize(), parser->GetLastXRefOffset(),
+          saved_parser->GetLastXRefOffset(), &defined, &update_xref_streams)) {
+    return false;
+  }
+  for (const auto& [objnum, freed] : defined) {
+    if (objnum == 0 && freed) {
+      continue;  // The free-list head.
+    }
+    if (!freed && (pdfium::Contains(objects, objnum) ||
+                   pdfium::Contains(update_xref_streams, objnum))) {
+      continue;
+    }
+    if (first_mismatch_objnum) {
+      *first_mismatch_objnum = objnum;
+    }
+    return false;
+  }
+
+  // 5. Deep comparison.
+  SaveVerifier verifier(doc, saved_doc.get());
+  for (const auto& [objnum, obj] : objects) {
+    RetainPtr<const CPDF_Object> saved_obj =
+        saved_doc->GetOrParseIndirectObject(objnum);
+    if (!verifier.ObjectsEqual(obj.Get(), saved_obj.Get(), 0)) {
+      if (first_mismatch_objnum) {
+        *first_mismatch_objnum = objnum;
+      }
+      return false;
+    }
+  }
+  return true;
+}
