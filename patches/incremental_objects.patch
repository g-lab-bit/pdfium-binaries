+// Classic cross-reference subsections: "start count" headers, then fixed
+// 20-byte in-use entries (ISO 32000-1:2008, 7.5.4). Offsets must be < 10^10.
+bool WriteClassicXRefEntries(IFX_ArchiveStream* archive,
+                             const std::map<uint32_t, FX_FILESIZE>& offsets) {
+  auto it = offsets.begin();
+  while (it != offsets.end()) {
+    auto run_end = it;
+    uint32_t count = 0;
+    while (run_end != offsets.end() && run_end->first == it->first + count) {
+      ++run_end;
+      ++count;
+    }
+    if (!archive->WriteString(
+            ByteString::Format("%u %u\r\n", it->first, count).AsStringView())) {
+      return false;
+    }
+    for (; it != run_end; ++it) {
+      if (!archive->WriteString(
+              ByteString::Format("%010lld 00000 n\r\n",
+                                 static_cast<long long>(it->second))
+                  .AsStringView())) {
+        return false;
+      }
+    }
+  }
+  return true;
