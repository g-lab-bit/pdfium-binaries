+// g-lab-bit fork (incremental_objects.patch).
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDF_SaveIncrementalObjects(FPDF_DOCUMENT document,
+                            FPDF_FILEWRITE* file_write,
+                            const uint32_t* objnums,
+                            size_t count) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  if (!doc || !file_write || (count && !objnums)) {
+    return false;
+  }
+  // SAFETY: required from caller.
+  pdfium::span<const uint32_t> objnum_span =
+      count ? UNSAFE_BUFFERS(pdfium::span(objnums, count))
+            : pdfium::span<const uint32_t>();
+  CPDF_Creator file_maker(
+      doc, pdfium::MakeRetain<CPDFSDK_FileWriteAdapter>(file_write));
+  return file_maker.CreateIncrementalObjects(objnum_span);
+}
+
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDFPage_GetObjectNumber(FPDF_PAGE page) {
+  CPDF_Page* pdf_page = CPDFPageFromFPDFPage(page);
+  if (!pdf_page || !pdf_page->GetDict()) {
+    return 0;
+  }
+  return pdf_page->GetDict()->GetObjNum();
+}
+
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDFPage_GetAnnotsObjectNumber(FPDF_PAGE page) {
+  CPDF_Page* pdf_page = CPDFPageFromFPDFPage(page);
+  if (!pdf_page || !pdf_page->GetDict()) {
+    return 0;
+  }
+  RetainPtr<const CPDF_Reference> ref =
+      ToReference(pdf_page->GetDict()->GetObjectFor("Annots"));
+  return ref ? ref->GetRefObjNum() : 0;
+}
+
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDFAnnot_GetObjectNumber(FPDF_ANNOTATION annot) {
+  CPDF_AnnotContext* context = CPDFAnnotContextFromFPDFAnnotation(annot);
+  if (!context || !context->GetAnnotDict()) {
+    return 0;
+  }
+  return context->GetAnnotDict()->GetObjNum();
+}
