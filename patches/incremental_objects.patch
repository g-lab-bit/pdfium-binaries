+bool CPDF_Parser::WriteWholeFileToArchive(IFX_ArchiveStream* archive) {
+  static constexpr FX_FILESIZE kBufferSize = 4096;
+  RetainPtr<CPDF_ReadValidator> validator = syntax_->GetValidator();
+  const FX_FILESIZE file_size = validator->GetSize();
+  DataVector<uint8_t> buffer(kBufferSize);
+  for (FX_FILESIZE pos = 0; pos < file_size;) {
+    const size_t block_size =
+        static_cast<size_t>(std::min(kBufferSize, file_size - pos));
+    auto block_span = pdfium::span(buffer).first(block_size);
+    if (!validator->ReadBlockAtOffset(block_span, pos) ||
+        !archive->WriteBlock(block_span)) {
+      return false;
+    }
+    pos += block_size;
+  }
+  return true;
+}
