+           archive_->WriteString(">>\r\nstartxref\r\n") &&
+           archive_->WriteFilesize(xref_start_) &&
+           archive_->WriteString("\r\n%%EOF\r\n") && file_archive->Flush();
+  }
+
+  // Cross-reference stream that lists itself.
+  offsets[xref_obj_num] = xref_start_;
+  int offset_width = 1;
+  while (offset_width < 8 &&
+         (static_cast<uint64_t>(xref_start_) >> (8 * offset_width)) != 0) {
+    ++offset_width;
+  }
+  ByteString index;
+  DataVector<uint8_t> data;
+  for (auto it = offsets.begin(); it != offsets.end();) {
+    auto run_end = it;
+    uint32_t count = 0;
+    while (run_end != offsets.end() && run_end->first == it->first + count) {
+      ++run_end;
+      ++count;
+    }
+    index += ByteString::Format("%u %u ", it->first, count);
+    for (; it != run_end; ++it) {
+      const uint64_t pos = static_cast<uint64_t>(it->second);
+      data.push_back(1);
+      for (int shift = 8 * (offset_width - 1); shift >= 0; shift -= 8) {
+        data.push_back(static_cast<uint8_t>(pos >> shift));
+      }
+      data.push_back(0);
+    }
+  }
+  return archive_->WriteDWord(xref_obj_num) &&
+         archive_->WriteString(" 0 obj\r\n<</Type/XRef") &&
+         WriteIncrementalTrailerEntries(trailer.Get(), id_array.Get(), size) &&
+         archive_->WriteString(
