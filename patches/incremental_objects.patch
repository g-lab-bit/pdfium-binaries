+// g-lab-bit fork (incremental_objects.patch).
+//
+// The update layout (xref table vs. xref stream chosen from the original's
+// last section, the stream listing itself with /Type/XRef and a sized /W,
+// trailer = /Root /Info /Encrypt /ID /Size /Prev) is ported from pdf.js
+// src/core/writer.js (incrementalUpdate, getXRefTable, getXRefStreamTable,
+// getTrailerDict, computeIDs), Copyright 2020 Mozilla Foundation, Apache
+// License 2.0.
+bool CPDF_Creator::CreateIncrementalObjects(
+    pdfium::span<const uint32_t> objnums) {
+  if (!parser_) {
+    return false;  // New document: nothing to append to.
+  }
+  // Refused: a rebuilt (damaged) xref cannot be continued with /Prev, and a
+  // document parsed through the linearized (FPDFAvail) path may not have
+  // loaded its main xref yet, so its last object number is not reliable.
+  if (parser_->xref_table_rebuilt() || parser_->GetLastXRefOffset() <= 0 ||
+      parser_->GetLinearizedHeader()) {
+    return false;
+  }
+  const CPDF_CrossRefTable* xref_table = parser_->GetCrossRefTable();
+  RetainPtr<const CPDF_Dictionary> trailer = parser_->GetCombinedTrailer();
+  if (!xref_table || !trailer || !trailer->GetObjectFor("Root")) {
+    return false;
+  }
+
+  const uint32_t parser_last_obj_num = parser_->GetLastObjNum();
+  const uint32_t encrypt_obj_num =
+      encrypt_dict_ ? encrypt_dict_->GetObjNum() : 0;
+  auto is_new = [parser_last_obj_num](uint32_t objnum) {
+    return objnum > parser_last_obj_num;
+  };
+
+  // 1. The object set: the listed objects (latest in-memory version) ...
+  std::map<uint32_t, RetainPtr<const CPDF_Object>> objects;
+  std::set<uint32_t> listed;
+  for (uint32_t objnum : objnums) {
+    // The /Encrypt dictionary is never rewritten.
+    if (objnum == 0 || objnum == CPDF_Object::kInvalidObjNum ||
+        objnum == encrypt_obj_num) {
+      return false;
+    }
+    RetainPtr<const CPDF_Object> obj =
+        document_->GetOrParseIndirectObject(objnum);
+    if (!obj) {
+      return false;
+    }
+    objects[objnum] = std::move(obj);
+    listed.insert(objnum);
+  }
+  // ... plus the objects created since load that are reachable from them (or
+  // from the trailer's /Root and /Info), following references through new
+  // objects only. Unreachable new objects (unused fonts, removed
+  // annotations' appearance streams, ...) are not written.
+  std::vector<RetainPtr<const CPDF_Object>> pending;
+  for (const auto& entry : objects) {
+    pending.push_back(entry.second);
+  }
+  auto add_new = [&](uint32_t objnum) {
+    if (!is_new(objnum) || pdfium::Contains(objects, objnum)) {
+      return true;
+    }
+    RetainPtr<const CPDF_Object> obj = document_->GetIndirectObject(objnum);
+    if (obj && obj->GetObjNum() == objnum) {
+      objects[objnum] = obj;
+      pending.push_back(std::move(obj));
+    }
+    return true;
+  };
+  for (const char* key : {"Root", "Info"}) {
+    const CPDF_Reference* ref = ToReference(trailer->GetObjectFor(key).Get());
+    if (ref) {
+      add_new(ref->GetRefObjNum());
+    }
+  }
