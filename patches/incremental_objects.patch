+// g-lab-bit fork (incremental_objects.patch) helpers.
+struct IncrementalXRefEntry {
+  FX_FILESIZE pos;
+  uint16_t gen;
+  bool in_use;
+};
+
+// Classic cross-reference subsections: "start count" headers, then fixed
+// 20-byte entries (ISO 32000-1:2008, 7.5.4).
+bool WriteClassicXRefEntries(
+    IFX_ArchiveStream* archive,
+    const std::map<uint32_t, IncrementalXRefEntry>& entries) {
+  auto it = entries.begin();
+  while (it != entries.end()) {
+    auto run_end = it;
+    uint32_t count = 0;
+    while (run_end != entries.end() && run_end->first == it->first + count) {
+      ++run_end;
+      ++count;
+    }
+    if (!archive->WriteString(
+            ByteString::Format("%u %u\r\n", it->first, count).AsStringView())) {
+      return false;
+    }
+    for (; it != run_end; ++it) {
+      const IncrementalXRefEntry& entry = it->second;
+      if (!archive->WriteString(
+              ByteString::Format("%010lld %05u %c\r\n",
+                                 static_cast<long long>(entry.pos),
+                                 static_cast<unsigned>(entry.gen),
+                                 entry.in_use ? 'n' : 'f')
+                  .AsStringView())) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+bool IsXMLMetadataStream(const CPDF_Object* obj) {
+  const CPDF_Stream* stream = obj->AsStream();
+  if (!stream) {
+    return false;
+  }
+  RetainPtr<const CPDF_Dictionary> dict = stream->GetDict();
+  return dict && dict->GetNameFor("Type") == "Metadata" &&
+         dict->GetNameFor("Subtype") == "XML";
+}
